@model TuitionCenter.Models.ViewModels.TeacherProfileViewModel
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Profile & Settings";
    ViewData["Subtitle"] = "Manage your personal details, qualifications, and teaching preferences.";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="mb-5 flex items-center gap-3 bg-emerald-50 border border-emerald-200 text-emerald-800 px-5 py-3.5 rounded-2xl text-xs font-semibold">
        <i class="fas fa-check-circle text-emerald-600 text-base"></i>
        @TempData["SuccessMessage"]
    </div>
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- LEFT: Profile Identity Card -->
    <div class="space-y-5">

        <!-- Profile Hero Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
            <!-- Gradient Banner -->
            <div class="h-28 bg-gradient-to-br from-[#0B4799] to-[#1E3A8A] relative">
                <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 16px 16px;"></div>
            </div>

            <!-- Avatar -->
            <div class="px-6 pb-6 -mt-10 text-center relative">
                <div class="relative inline-block">
                    <img src="@(string.IsNullOrEmpty(Model.PhotoPath) ? "https://i.pravatar.cc/150?img=11" : Model.PhotoPath)"
                         alt="Teacher Photo" 
                         class="w-20 h-20 rounded-2xl border-4 border-white object-cover shadow-lg mx-auto" />
                    @if (Model.IsVerified)
                    {
                        <span class="absolute -bottom-1 -right-1 w-6 h-6 bg-[#0B4799] rounded-full flex items-center justify-center border-2 border-white">
                            <i class="fas fa-check text-white text-[9px]"></i>
                        </span>
                    }
                </div>

                <h2 class="text-xl font-extrabold text-slate-900 mt-3 leading-tight">@Model.FullName</h2>
                <p class="text-xs text-slate-500 font-medium mt-0.5">@Model.SubjectSpecialization</p>

                @if (Model.IsVerified)
                {
                    <span class="inline-flex items-center gap-1 bg-blue-50 text-[#0B4799] border border-blue-100 text-[10px] font-extrabold px-3 py-1 rounded-full mt-2">
                        <i class="fas fa-shield-halved text-[9px]"></i> Verified Faculty
                    </span>
                }
            </div>
        </div>

        <!-- Stats Mini Cards -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
            <h3 class="text-xs font-extrabold text-slate-400 uppercase tracking-wider mb-4">Teaching Stats</h3>
            <div class="space-y-3">
                <div class="flex items-center justify-between py-2.5 border-b border-slate-100">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-blue-100 text-[#0B4799] flex items-center justify-center text-xs">
                            <i class="fas fa-users"></i>
                        </div>
                        <span class="text-xs font-semibold text-slate-600">Total Students</span>
                    </div>
                    <span class="text-base font-extrabold text-slate-900">@Model.TotalStudents</span>
                </div>

                <div class="flex items-center justify-between py-2.5 border-b border-slate-100">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs">
                            <i class="fas fa-chalkboard"></i>
                        </div>
                        <span class="text-xs font-semibold text-slate-600">Active Batches</span>
                    </div>
                    <span class="text-base font-extrabold text-slate-900">@Model.CurrentLoad</span>
                </div>

                <div class="flex items-center justify-between py-2.5 border-b border-slate-100">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-xs">
                            <i class="fas fa-star"></i>
                        </div>
                        <span class="text-xs font-semibold text-slate-600">Rating</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="text-base font-extrabold text-slate-900">@Model.Rating</span>
                        <span class="text-[10px] text-amber-500">/5.0</span>
                    </div>
                </div>

                <div class="flex items-center justify-between py-2.5">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center text-xs">
                            <i class="fas fa-clock"></i>
                        </div>
                        <span class="text-xs font-semibold text-slate-600">Experience</span>
                    </div>
                    <span class="text-sm font-extrabold text-slate-900">@Model.YearsOfExperience</span>
                </div>
            </div>
        </div>

        <!-- Teaching Levels -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
            <h3 class="text-xs font-extrabold text-slate-400 uppercase tracking-wider mb-3">Teaching Levels</h3>
            <div class="flex flex-wrap gap-2">
                @foreach (var level in Model.TeachingLevels)
                {
                    <span class="bg-blue-50 text-[#0B4799] border border-blue-100 text-xs font-bold px-3 py-1.5 rounded-xl">@level</span>
                }
            </div>
        </div>

        <!-- Assigned Subjects -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-xs">
            <h3 class="text-xs font-extrabold text-slate-400 uppercase tracking-wider mb-3">Assigned Subjects</h3>
            <div class="space-y-3">
                @foreach (var group in Model.AssignedSubjects)
                {
                    <div>
                        <p class="text-[10px] font-extrabold text-[#0B4799] uppercase tracking-wider mb-1">@group.ClassName</p>
                        <p class="text-xs text-slate-600 font-medium">@group.Subjects</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT: Edit Profile Tabs -->
    <div class="lg:col-span-2 space-y-5">

        <!-- Tab Navigation -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
            <div class="flex border-b border-slate-200" id="profileTabNav">
                <button class="profile-tab-btn flex-1 py-3.5 text-xs font-extrabold transition-all text-[#0B4799] border-b-2 border-[#0B4799] bg-blue-50/50" data-tab="personal">
                    <i class="fas fa-user mr-1.5"></i> Personal Info
                </button>
                <button class="profile-tab-btn flex-1 py-3.5 text-xs font-extrabold transition-all text-slate-500 hover:text-slate-700 hover:bg-slate-50" data-tab="qualifications">
                    <i class="fas fa-graduation-cap mr-1.5"></i> Qualifications
                </button>
                <button class="profile-tab-btn flex-1 py-3.5 text-xs font-extrabold transition-all text-slate-500 hover:text-slate-700 hover:bg-slate-50" data-tab="professional">
                    <i class="fas fa-briefcase mr-1.5"></i> Professional
                </button>
            </div>

            <!-- Form -->
            <form method="post" action="@Url.Action("Profile", "Teacher")" enctype="multipart/form-data" class="p-6">
                @Html.AntiForgeryToken()

                <!-- Tab: Personal Info -->
                <div id="tab-personal" class="profile-tab-content space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">Profile Picture</label>
                        <input type="file" name="photoFile" accept="image/*"
                               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-600 outline-none transition-all" />
                        <p class="text-[11px] text-slate-400 mt-1">Upload a JPG, PNG, or WebP image to feature on your avatar and navigation header.</p>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Full Name</label>
                            <input type="text" name="FullName" value="@Model.FullName" required
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Email Address</label>
                            <input type="email" name="Email" value="@Model.Email" readonly
                                   class="w-full bg-slate-100 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-500 outline-none cursor-not-allowed" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Phone Number</label>
                            <input type="tel" name="Phone" value="@Model.Phone"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Date of Birth</label>
                            <input type="date" name="DateOfBirth" value="@Model.DateOfBirth"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">Short Bio</label>
                        <textarea name="Bio" rows="4" placeholder="Tell students about yourself..."
                                  class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all resize-none">@Model.Bio</textarea>
                    </div>
                </div>

                <!-- Tab: Qualifications -->
                <div id="tab-qualifications" class="profile-tab-content space-y-4 hidden">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Highest Degree</label>
                            <input type="text" name="HighestDegree" value="@Model.HighestDegree" placeholder="e.g. Master of Education"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Institution</label>
                            <input type="text" name="Institution" value="@Model.Institution" placeholder="e.g. Tribhuvan University"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Year of Graduation</label>
                            <input type="text" name="YearOfGraduation" value="@Model.YearOfGraduation" placeholder="e.g. 2015"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all" />
                        </div>
                    </div>
                </div>

                <!-- Tab: Professional -->
                <div id="tab-professional" class="profile-tab-content space-y-4 hidden">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Subject Specialization</label>
                            <input type="text" name="SubjectSpecialization" value="@Model.SubjectSpecialization" placeholder="e.g. Mathematics & Physics"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Years of Experience</label>
                            <input type="text" name="YearsOfExperience" value="@Model.YearsOfExperience" placeholder="e.g. 8 Years"
                                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none transition-all" />
                        </div>
                    </div>
                </div>

                <!-- Save Button -->
                <div class="pt-5 mt-5 border-t border-slate-100 flex justify-end gap-3">
                    <a href="@Url.Action("Dashboard", "Teacher")" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-all">
                        Cancel
                    </a>
                    <button type="submit" class="px-6 py-2.5 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl font-extrabold text-xs shadow-md shadow-blue-600/20 transition-all flex items-center gap-2">
                        <i class="fas fa-save text-xs"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>

        <!-- Security Section -->
        <div class="bg-white rounded-2xl border border-slate-200/80 p-6 shadow-xs">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
                        <i class="fas fa-lock text-[#0B4799]"></i> Account Security
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Manage password and portal access credentials</p>
                </div>
            </div>
            <div class="flex items-center justify-between p-4 bg-slate-50 rounded-xl border border-slate-100">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-lg bg-slate-200 text-slate-600 flex items-center justify-center text-sm">
                        <i class="fas fa-key"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-800">Password</p>
                        <p class="text-[10px] text-slate-400">Last changed 3 months ago</p>
                    </div>
                </div>
                <button class="px-4 py-1.5 bg-white border border-slate-200 hover:bg-blue-50 text-slate-700 hover:text-[#0B4799] rounded-lg text-xs font-bold transition-all">
                    Change Password
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Profile Tab Navigation
        const tabBtns = document.querySelectorAll('.profile-tab-btn');
        const tabContents = document.querySelectorAll('.profile-tab-content');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const tab = btn.getAttribute('data-tab');

                tabBtns.forEach(b => {
                    b.classList.remove('text-[#0B4799]', 'border-b-2', 'border-[#0B4799]', 'bg-blue-50/50');
                    b.classList.add('text-slate-500', 'hover:text-slate-700');
                });
                btn.classList.add('text-[#0B4799]', 'border-b-2', 'border-[#0B4799]', 'bg-blue-50/50');
                btn.classList.remove('text-slate-500');

                tabContents.forEach(tc => tc.classList.add('hidden'));
                document.getElementById('tab-' + tab)?.classList.remove('hidden');
            });
        });
    </script>
}
