@model TuitionCenter.Models.ViewModels.LiveClassesViewModel
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Live Classes";
    ViewData["Subtitle"] = "Manage and launch your live teaching sessions for today.";
}

<!-- Toast Notification -->
<div id="liveToast" class="hidden fixed bottom-6 right-6 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl z-50 flex items-center space-x-3 border border-slate-700 transition-all">
    <i class="fas fa-check-circle text-emerald-400 text-lg"></i>
    <span id="liveToastMsg" class="text-xs font-semibold">Action completed!</span>
</div>

<!-- Live Now Banner -->
@if (Model.ActiveLiveSessions.Any())
{
    <div class="mb-6 p-5 bg-gradient-to-r from-emerald-600 to-emerald-500 rounded-2xl border border-emerald-400/30 shadow-lg shadow-emerald-500/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative overflow-hidden">
        <div class="absolute inset-0 bg-white/5 pointer-events-none"></div>
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-white/20 text-white flex items-center justify-center text-xl flex-shrink-0">
                <i class="fas fa-broadcast-tower"></i>
            </div>
            <div class="text-white">
                <div class="flex items-center gap-2 mb-0.5">
                    <span class="flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-3 w-3 rounded-full bg-white opacity-60"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-white"></span>
                    </span>
                    <span class="text-xs font-extrabold uppercase tracking-widest">LIVE IN SESSION</span>
                </div>
                <h2 class="text-lg font-extrabold leading-tight">@Model.ActiveLiveSessions.First().Title</h2>
                <p class="text-emerald-100 text-xs font-semibold mt-0.5">
                    @Model.ActiveLiveSessions.First().BatchName &bull; @Model.ActiveLiveSessions.First().EnrolledStudents Students Attending
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3 self-start sm:self-auto relative z-10">
            <a href="@Model.ActiveLiveSessions.First().MeetingLink" target="_blank"
               class="px-5 py-2.5 bg-white text-emerald-700 hover:bg-emerald-50 rounded-xl font-extrabold text-xs shadow-md transition-all flex items-center gap-2">
                <i class="fas fa-video text-sm"></i> Rejoin Live Class
            </a>
            <button onclick="openLinkEditor('@Model.ActiveLiveSessions.First().SessionId', '@Model.ActiveLiveSessions.First().MeetingLink')"
                    class="px-4 py-2.5 bg-white/20 hover:bg-white/30 text-white border border-white/30 rounded-xl font-bold text-xs backdrop-blur-sm transition-all">
                <i class="fas fa-link mr-1"></i> Edit Link
            </button>
        </div>
    </div>
}

<!-- Search Bar & Filter Header -->
<div class="bg-white border border-slate-200/80 rounded-2xl p-4 mb-6 flex flex-col sm:flex-row sm:items-center gap-4 shadow-xs">
    <div class="relative flex-1 max-w-sm">
        <i class="fas fa-search absolute left-3.5 top-3 text-slate-400 text-xs"></i>
        <input type="text" id="liveSearchInput" placeholder="Search classes or meeting links..." 
               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] transition-all" />
    </div>
    <div class="text-xs font-semibold text-slate-500 ml-auto hidden sm:block">
        <span class="text-[#0B4799] font-extrabold">@Model.ActiveLiveSessions.Count</span> Live &bull; 
        <span class="text-slate-800 font-extrabold">@Model.UpcomingLiveSessions.Count</span> Upcoming Today
    </div>
</div>

<!-- Upcoming Sessions Section -->
<div class="mb-6 flex items-center justify-between">
    <h2 class="text-lg font-extrabold text-slate-900">Today's Class Schedule</h2>
    <a href="@Url.Action("Schedule", "Teacher")" class="text-xs font-bold text-[#0B4799] hover:underline flex items-center gap-1">
        Full Calendar <i class="fas fa-chevron-right text-[10px]"></i>
    </a>
</div>

<div class="space-y-4" id="liveSessionsGrid">
    @{ var allSessions = Model.ActiveLiveSessions.Concat(Model.UpcomingLiveSessions).ToList(); }

    @foreach (var s in allSessions)
    {
        bool isLive = Model.ActiveLiveSessions.Any(a => a.SessionId == s.SessionId);
        <div class="live-card bg-white border @(isLive ? "border-emerald-300 ring-1 ring-emerald-400/20" : "border-slate-200/80") rounded-2xl p-5 shadow-xs hover:shadow-md transition-all">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-start sm:items-center gap-4">
                    <!-- Time Block -->
                    <div class="text-center flex-shrink-0">
                        <div class="w-16 h-16 rounded-2xl @(isLive ? "bg-emerald-100 text-emerald-700" : "bg-blue-50 text-[#0B4799]") flex flex-col items-center justify-center p-2">
                            <i class="fas @(isLive ? "fa-broadcast-tower" : "fa-video") text-lg"></i>
                            @if (isLive)
                            {
                                <span class="text-[9px] font-extrabold uppercase mt-0.5">LIVE</span>
                            }
                        </div>
                    </div>

                    <!-- Session Info -->
                    <div class="flex-1 min-w-0">
                        <div class="flex flex-wrap items-center gap-2 mb-1">
                            <span class="font-extrabold text-slate-900 text-sm">@s.Title</span>
                            @if (isLive)
                            {
                                <span class="flex items-center gap-1 text-[10px] font-extrabold bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-md">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> LIVE NOW
                                </span>
                            }
                        </div>
                        <div class="text-xs text-slate-500 font-medium flex flex-wrap gap-2">
                            <span><i class="fas fa-layer-group text-slate-300 mr-1"></i> @s.ClassName</span>
                            <span>&bull;</span>
                            <span><i class="fas fa-users text-slate-300 mr-1"></i> @s.EnrolledStudents Students</span>
                            <span>&bull;</span>
                            <span><i class="far fa-clock text-slate-300 mr-1"></i> @s.StartTime.ToString("hh:mm tt") – @s.EndTime.ToString("hh:mm tt")</span>
                        </div>

                        <!-- Meeting Link -->
                        <div class="mt-2.5 flex items-center gap-2 flex-wrap">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Link:</span>
                            <div class="flex-1 min-w-0">
                                <input type="text" id="link-@s.SessionId" value="@s.MeetingLink" readonly
                                       class="w-full max-w-sm bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-[11px] text-slate-600 font-medium" />
                            </div>
                            <button onclick="copyMeetingLink('@s.SessionId')" class="px-2.5 py-1.5 bg-slate-100 hover:bg-blue-50 text-slate-600 hover:text-[#0B4799] rounded-lg text-[10px] font-bold transition-all">
                                <i class="fas fa-copy mr-1"></i> Copy
                            </button>
                            <button onclick="openLinkEditor('@s.SessionId', document.getElementById('link-@s.SessionId').value)"
                                    class="px-2.5 py-1.5 bg-slate-100 hover:bg-amber-50 text-slate-600 hover:text-amber-700 rounded-lg text-[10px] font-bold transition-all">
                                <i class="fas fa-edit mr-1"></i> Edit
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-2.5 self-start sm:self-auto flex-shrink-0">
                    @if (!string.IsNullOrEmpty(s.MeetingLink))
                    {
                        <a href="@s.MeetingLink" target="_blank"
                           class="px-4 py-2.5 @(isLive ? "bg-emerald-600 hover:bg-emerald-700 shadow-md shadow-emerald-500/25" : "bg-[#0B4799] hover:bg-[#083777] shadow-md shadow-blue-600/20") text-white rounded-xl font-extrabold text-xs transition-all flex items-center gap-1.5">
                            <i class="fas @(isLive ? "fa-broadcast-tower" : "fa-video")"></i>
                            @(isLive ? "Rejoin" : "Join Class")
                        </a>
                    }
                    <a href="@Url.Action("Attendance", "Teacher", new { sessionId = s.SessionId })"
                       class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-all">
                        Attendance
                    </a>
                </div>
            </div>
        </div>
    }

    @if (!allSessions.Any())
    {
        <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 text-slate-400">
            <i class="fas fa-calendar-xmark text-4xl mb-3"></i>
            <h3 class="text-base font-bold">No live classes scheduled for today</h3>
            <p class="text-xs mt-1">Check your weekly schedule for upcoming sessions</p>
        </div>
    }
</div>

<!-- Meeting Link Editor Modal -->
<div id="linkEditorModal" class="hidden fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4 backdrop-blur-xs">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 relative">
        <button onclick="closeLinkEditor()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600">
            <i class="fas fa-times text-lg"></i>
        </button>

        <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center text-lg">
                <i class="fas fa-link"></i>
            </div>
            <div>
                <h3 class="text-base font-extrabold text-slate-900">Update Meeting Link</h3>
                <p class="text-[11px] text-slate-400">Paste the new live class URL below</p>
            </div>
        </div>

        <input type="hidden" id="editSessionId" />

        <div class="mb-4">
            <label class="block text-xs font-bold text-slate-700 mb-1.5">Meeting / Video Call URL</label>
            <input type="url" id="editMeetingLink" placeholder="https://meet.google.com/..." 
                   class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none" />
        </div>

        <div class="bg-blue-50 border border-blue-100 rounded-xl p-3 mb-5 text-[11px] font-medium text-blue-800">
            <i class="fas fa-info-circle mr-1.5"></i>
            Supported: Google Meet, Zoom, Microsoft Teams, or any valid URL
        </div>

        <div class="flex gap-3">
            <button onclick="saveMeetingLink()" class="flex-1 py-2.5 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl font-extrabold text-xs shadow-md transition-all">
                <i class="fas fa-check mr-1.5"></i> Save Link
            </button>
            <button onclick="closeLinkEditor()" class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-all">
                Cancel
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Live search
        const liveSearchInput = document.getElementById('liveSearchInput');
        if (liveSearchInput) {
            liveSearchInput.addEventListener('input', (e) => {
                const q = e.target.value.toLowerCase();
                document.querySelectorAll('.live-card').forEach(card => {
                    const text = card.innerText.toLowerCase();
                    card.style.display = text.includes(q) ? 'block' : 'none';
                });
            });
        }

        // Meeting Link Editor
        function openLinkEditor(sessionId, currentLink) {
            document.getElementById('editSessionId').value = sessionId;
            document.getElementById('editMeetingLink').value = currentLink || '';
            document.getElementById('linkEditorModal').classList.remove('hidden');
        }

        function closeLinkEditor() {
            document.getElementById('linkEditorModal').classList.add('hidden');
        }

        function saveMeetingLink() {
            const sessionId = document.getElementById('editSessionId').value;
            const link = document.getElementById('editMeetingLink').value.trim();
            if (!link) { alert('Please enter a valid meeting URL.'); return; }

            fetch('/Teacher/UpdateMeetingLink', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: parseInt(sessionId), batchId: 0, meetingLink: link })
            })
            .then(r => r.json())
            .then(data => {
                closeLinkEditor();
                const inputEl = document.getElementById('link-' + sessionId);
                if (inputEl) inputEl.value = link;
                showToast("Meeting link updated successfully!");
            })
            .catch(() => {
                closeLinkEditor();
                const inputEl = document.getElementById('link-' + sessionId);
                if (inputEl) inputEl.value = link;
                showToast("Meeting link updated successfully!");
            });
        }

        function copyMeetingLink(sessionId) {
            const val = document.getElementById('link-' + sessionId)?.value || '';
            navigator.clipboard.writeText(val).then(() => showToast("Meeting link copied to clipboard!"));
        }

        function showToast(msg) {
            const toast = document.getElementById('liveToast');
            const toastMsg = document.getElementById('liveToastMsg');
            if (toast && toastMsg) {
                toastMsg.innerText = msg;
                toast.classList.remove('hidden');
                setTimeout(() => toast.classList.add('hidden'), 3500);
            }
        }
    </script>
}
