@model TuitionCenter.Models.ViewModels.TeacherDashboardViewModel
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Teacher Dashboard";
    ViewData["Subtitle"] = "Here's what's happening with your classes and students today.";
}

<!-- Toast Notification -->
<div id="dashboardToast" class="hidden fixed bottom-6 right-6 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl z-50 flex items-center space-x-3 border border-slate-700 transition-all">
    <i class="fas fa-check-circle text-emerald-400 text-lg"></i>
    <span id="dashboardToastMsg" class="text-xs font-semibold">Action completed successfully!</span>
</div>

<!-- Welcome Header Section -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs">
    <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">
            Good Morning, <span class="text-[#0B4799]">@Model.TeacherName</span>! 👋
        </h1>
        <p class="text-slate-500 text-sm mt-1">
            You have <span class="font-bold text-slate-800">@(Model.NextClass != null ? Model.UpcomingClasses.Count + 1 : 0) class sessions</span> scheduled on your agenda.
        </p>
    </div>
    <div class="flex items-center gap-3">
        <div class="bg-blue-50 border border-blue-100 px-4 py-2.5 rounded-xl text-right">
            <p class="text-[10px] font-bold text-[#0B4799] uppercase tracking-wider">Academic Term</p>
            <p class="text-sm font-extrabold text-slate-900">@Model.CurrentAcademicYear</p>
        </div>
        <a href="@Url.Action("Schedule", "Teacher")" class="px-4 py-2.5 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl font-bold text-xs shadow-md shadow-blue-600/20 transition-all flex items-center gap-2">
            <i class="fas fa-calendar-plus text-xs"></i> Full Schedule
        </a>
    </div>
</div>

<!-- Top Stats Overview Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Stat Card 1 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-all flex items-center justify-between">
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">TOTAL STUDENTS</p>
            <h3 class="text-2xl font-extrabold text-slate-900 mt-1">@Model.TotalStudents</h3>
            <p class="text-[11px] font-semibold text-emerald-600 mt-1 flex items-center gap-1">
                <i class="fas fa-arrow-up text-[9px]"></i> +12% this month
            </p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-blue-50 text-[#0B4799] flex items-center justify-center text-xl font-bold">
            <i class="fas fa-user-graduate"></i>
        </div>
    </div>

    <!-- Stat Card 2 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-all flex items-center justify-between">
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">ACTIVE BATCHES</p>
            <h3 class="text-2xl font-extrabold text-slate-900 mt-1">@Model.ActiveClasses</h3>
            <p class="text-[11px] font-semibold text-blue-600 mt-1">Across 3 academic levels</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
            <i class="fas fa-chalkboard-user"></i>
        </div>
    </div>

    <!-- Stat Card 3 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-all flex items-center justify-between">
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">AVG ATTENDANCE</p>
            <h3 class="text-2xl font-extrabold text-slate-900 mt-1">@Model.AverageAttendance%</h3>
            <p class="text-[11px] font-semibold text-emerald-600 mt-1 flex items-center gap-1">
                <i class="fas fa-check text-[9px]"></i> Consistent rate
            </p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl font-bold">
            <i class="fas fa-chart-line"></i>
        </div>
    </div>

    <!-- Stat Card 4 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-all flex items-center justify-between">
        <div>
            <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">TEACHING HOURS</p>
            <h3 class="text-2xl font-extrabold text-slate-900 mt-1">24 hrs/wk</h3>
            <p class="text-[11px] font-semibold text-amber-600 mt-1">Optimal workload</p>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
            <i class="fas fa-clock"></i>
        </div>
    </div>
</div>

<!-- Main Next Class Banner & Side Actions -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10">
    <!-- Next Class Featured Hero Card -->
    <div class="lg:col-span-2">
        @if (Model.NextClass != null)
        {
            <div class="bg-gradient-to-br from-[#0B4799] via-[#093D84] to-[#1E3A8A] rounded-3xl p-6 md:p-8 text-white shadow-xl shadow-blue-900/10 relative overflow-hidden flex flex-col justify-between" style="min-height: 280px;">
                <!-- Decorative background elements -->
                <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>

                <div>
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
                        <span class="inline-flex items-center gap-2 bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 text-xs font-extrabold px-3.5 py-1.5 rounded-full backdrop-blur-sm">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                            NEXT CLASS AT @Model.NextClass.StartTime.ToString("hh:mm tt")
                        </span>
                        <span class="text-xs font-semibold text-blue-200 bg-white/10 px-3 py-1 rounded-lg backdrop-blur-xs">
                            @Model.NextClass.DurationMinutes mins duration
                        </span>
                    </div>

                    <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-2">@Model.NextClass.Title</h2>
                    <p class="text-blue-100 text-xs md:text-sm flex flex-wrap items-center gap-2 font-medium">
                        <span><i class="fas fa-layer-group text-blue-300 mr-1"></i> @Model.NextClass.ClassName</span>
                        <span>&bull;</span>
                        <span><i class="fas fa-book-open text-blue-300 mr-1"></i> @Model.NextClass.SubjectName</span>
                        <span>&bull;</span>
                        <span><i class="fas fa-users text-blue-300 mr-1"></i> @Model.NextClass.EnrolledStudents Students</span>
                    </p>
                </div>

                <div class="pt-6 border-t border-white/10 mt-6 flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        @if (!string.IsNullOrEmpty(Model.NextClass.MeetingLink))
                        {
                            <a href="@Model.NextClass.MeetingLink" target="_blank" class="bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold px-6 py-3 rounded-xl text-xs shadow-lg shadow-emerald-500/30 transition-all flex items-center gap-2">
                                <i class="fas fa-video text-sm"></i> Launch Live Class
                            </a>
                        }
                        <button onclick="copyMeetingLink('@Model.NextClass.MeetingLink')" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 font-bold px-4 py-3 rounded-xl text-xs backdrop-blur-sm transition-all flex items-center gap-2">
                            <i class="fas fa-copy"></i> Share Link
                        </button>
                    </div>

                    <a href="@Url.Action("Attendance", "Teacher", new { sessionId = Model.NextClass.SessionId })" class="text-blue-200 hover:text-white font-semibold text-xs flex items-center gap-1.5 hover:underline">
                        Take Attendance <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white rounded-3xl p-8 border border-slate-200/80 text-center flex flex-col items-center justify-center shadow-xs" style="min-height: 280px;">
                <div class="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center text-2xl mb-3">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-800">No classes remaining today!</h3>
                <p class="text-xs text-slate-400 max-w-sm mt-1">Great job! You have completed all scheduled teaching sessions for today.</p>
            </div>
        }
    </div>

    <!-- Quick Actions Side Panel -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs flex flex-col justify-between">
        <div>
            <h3 class="text-base font-extrabold text-slate-900 mb-4 flex items-center gap-2">
                <i class="fas fa-bolt text-amber-500"></i> Quick Actions
            </h3>
            <div class="space-y-3">
                <a href="@Url.Action("LiveClasses", "Teacher")" class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 hover:bg-blue-50 text-slate-700 hover:text-[#0B4799] transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-blue-100 text-[#0B4799] flex items-center justify-center font-bold">
                            <i class="fas fa-video text-sm"></i>
                        </div>
                        <span class="text-xs font-bold">Launch Live Stream</span>
                    </div>
                    <i class="fas fa-chevron-right text-xs text-slate-400 group-hover:translate-x-1 transition-transform"></i>
                </a>

                <a href="@Url.Action("ClassManagement", "Teacher")" class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold">
                            <i class="fas fa-plus text-sm"></i>
                        </div>
                        <span class="text-xs font-bold">Create Class Session</span>
                    </div>
                    <i class="fas fa-chevron-right text-xs text-slate-400 group-hover:translate-x-1 transition-transform"></i>
                </a>

                <a href="@Url.Action("Students", "Teacher")" class="flex items-center justify-between p-3.5 rounded-2xl bg-slate-50 hover:bg-purple-50 text-slate-700 hover:text-purple-700 transition-all group">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center font-bold">
                            <i class="fas fa-user-group text-sm"></i>
                        </div>
                        <span class="text-xs font-bold">View Student Roster</span>
                    </div>
                    <i class="fas fa-chevron-right text-xs text-slate-400 group-hover:translate-x-1 transition-transform"></i>
                </a>
            </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-100">
            <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-slate-500">System Status</span>
                <span class="text-emerald-600 font-extrabold flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Online
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Upcoming Classes Section -->
<div class="mb-6 flex items-center justify-between">
    <div>
        <h2 class="text-xl font-extrabold text-slate-900">Upcoming Class Agenda</h2>
        <p class="text-xs text-slate-500 mt-0.5">Classes queued for today and upcoming dates</p>
    </div>
    <a href="@Url.Action("Schedule", "Teacher")" class="text-[#0B4799] font-bold text-xs hover:underline flex items-center gap-1">
        View Calendar <i class="fas fa-chevron-right text-[10px]"></i>
    </a>
</div>

<div class="space-y-3">
    @if (Model.UpcomingClasses.Any())
    {
        foreach (var cls in Model.UpcomingClasses)
        {
            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-start sm:items-center gap-4">
                    <div class="text-center w-20 bg-slate-50 p-2.5 rounded-xl border border-slate-100 flex-shrink-0">
                        <div class="text-[#0B4799] font-extrabold text-base leading-tight">
                            @cls.StartTime.ToString("hh:mm")
                        </div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase mt-0.5">@cls.StartTime.ToString("tt")</div>
                    </div>
                    <div>
                        <span class="bg-blue-100 text-[#0B4799] text-[10px] font-bold px-2.5 py-0.5 rounded-md uppercase">
                            @cls.ClassName
                        </span>
                        <h3 class="text-base font-extrabold text-slate-900 mt-1">@cls.Title</h3>
                        <p class="text-xs text-slate-500 font-medium mt-0.5">
                            @cls.SubjectName &bull; @cls.BatchName &bull; @cls.EnrolledStudents Students Enrolled
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3 self-end sm:self-center">
                    @if (!string.IsNullOrEmpty(cls.MeetingLink))
                    {
                        <a href="@cls.MeetingLink" target="_blank" class="px-4 py-2 bg-slate-100 hover:bg-blue-50 text-slate-700 hover:text-[#0B4799] rounded-xl font-bold text-xs transition-all flex items-center gap-1.5">
                            <i class="fas fa-video text-xs"></i> Join Link
                        </a>
                    }
                    <a href="@Url.Action("Attendance", "Teacher", new { sessionId = cls.SessionId })" class="px-4 py-2 bg-blue-50 hover:bg-[#0B4799] text-[#0B4799] hover:text-white rounded-xl font-bold text-xs transition-all">
                        Attendance
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center p-8 bg-white rounded-2xl border border-slate-200 text-slate-400 text-xs font-semibold">
            No further upcoming classes queued for today.
        </div>
    }
</div>

@section Scripts {
    <script>
        function copyMeetingLink(link) {
            if (!link) link = "https://meet.google.com/demo-class";
            navigator.clipboard.writeText(link).then(() => {
                showToast("Class meeting link copied to clipboard!");
            });
        }

        function showToast(msg) {
            const toast = document.getElementById('dashboardToast');
            const toastMsg = document.getElementById('dashboardToastMsg');
            if (toast && toastMsg) {
                toastMsg.innerText = msg;
                toast.classList.remove('hidden');
                setTimeout(() => toast.classList.add('hidden'), 3500);
            }
        }
    </script>
}