@model TuitionCenter.Models.ViewModels.TeacherStudentsViewModel
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Student Roster";
    ViewData["Subtitle"] = "View and track all students enrolled across your teaching batches.";
}

<!-- Header & Actions Row -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Enrolled Students</h1>
        <p class="text-xs text-slate-500 mt-0.5">
            <span class="font-extrabold text-[#0B4799]">@Model.Students.Count</span> students across all your active batches
        </p>
    </div>
    <div class="flex items-center gap-2.5 self-start sm:self-auto">
        <button onclick="exportToCSV()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-all flex items-center gap-1.5">
            <i class="fas fa-file-csv text-emerald-600"></i> Export
        </button>
        <a href="@Url.Action("Attendance", "Teacher")" class="px-4 py-2.5 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl font-bold text-xs shadow-md shadow-blue-600/20 transition-all flex items-center gap-1.5">
            <i class="fas fa-clipboard-check"></i> Mark Attendance
        </a>
    </div>
</div>

<!-- Batch Filter Tabs -->
<div class="flex flex-wrap items-center gap-2 mb-6">
    <a href="@Url.Action("Students", "Teacher")" 
       class="px-4 py-2 @(Model.SelectedBatchId == 0 ? "bg-[#0B4799] text-white shadow-md shadow-blue-600/15" : "bg-white text-slate-600 hover:text-[#0B4799] border border-slate-200") rounded-xl text-xs font-bold transition-all">
        All Batches
    </a>
    @foreach (var batch in Model.TeacherBatches)
    {
        <a href="@Url.Action("Students", "Teacher", new { batchId = batch.BatchId })" 
           class="px-4 py-2 @(Model.SelectedBatchId == batch.BatchId ? "bg-[#0B4799] text-white shadow-md shadow-blue-600/15" : "bg-white text-slate-600 hover:text-[#0B4799] border border-slate-200") rounded-xl text-xs font-bold transition-all">
            @batch.ClassName - @batch.SubjectName
        </a>
    }
</div>

<!-- Search & Stats Bar -->
<div class="bg-white border border-slate-200/80 rounded-2xl p-4 mb-5 flex flex-col sm:flex-row sm:items-center gap-4 shadow-xs">
    <div class="relative flex-1 max-w-xs">
        <i class="fas fa-search absolute left-3.5 top-3 text-slate-400 text-xs"></i>
        <input type="text" id="studentSearch" placeholder="Search students by name or email..." 
               class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] transition-all" />
    </div>

    <!-- Stats Chips -->
    <div class="flex flex-wrap items-center gap-3 sm:ml-auto text-xs">
        <span class="flex items-center gap-1.5 bg-emerald-50 text-emerald-700 border border-emerald-100 px-3 py-1.5 rounded-xl font-bold">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            @Model.Students.Count(s => s.Status == "Active") Active
        </span>
        <span class="flex items-center gap-1.5 bg-blue-50 text-[#0B4799] border border-blue-100 px-3 py-1.5 rounded-xl font-bold">
            <i class="fas fa-chart-line text-[10px]"></i>
            Avg: @(Model.Students.Any() ? Model.Students.Average(s => s.AttendancePercentage).ToString("F1") : "0")% Attendance
        </span>
    </div>
</div>

<!-- Students Table -->
<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-xs" id="studentsTable">
            <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                    <th class="px-4 py-3.5 text-left font-extrabold text-slate-500 uppercase tracking-wider">#</th>
                    <th class="px-4 py-3.5 text-left font-extrabold text-slate-500 uppercase tracking-wider">Student</th>
                    <th class="px-4 py-3.5 text-left font-extrabold text-slate-500 uppercase tracking-wider hidden md:table-cell">Batch / Class</th>
                    <th class="px-4 py-3.5 text-left font-extrabold text-slate-500 uppercase tracking-wider hidden sm:table-cell">Enrolled</th>
                    <th class="px-4 py-3.5 text-left font-extrabold text-slate-500 uppercase tracking-wider">Attendance</th>
                    <th class="px-4 py-3.5 text-left font-extrabold text-slate-500 uppercase tracking-wider">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    var s = Model.Students[i];
                    string initial = s.FullName.Length > 0 ? s.FullName[0].ToString().ToUpper() : "S";
                    string[] avatarColors = { "bg-blue-100 text-blue-700", "bg-emerald-100 text-emerald-700", "bg-purple-100 text-purple-700", "bg-amber-100 text-amber-700", "bg-rose-100 text-rose-700" };
                    string avatarColor = avatarColors[i % avatarColors.Length];

                    <tr class="student-row hover:bg-slate-50/70 transition-colors">
                        <td class="px-4 py-4 text-slate-400 font-bold">@(i + 1)</td>
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl @avatarColor flex items-center justify-center font-extrabold text-sm flex-shrink-0">
                                    @initial
                                </div>
                                <div>
                                    <p class="font-extrabold text-slate-900 student-name">@s.FullName</p>
                                    <p class="text-slate-400 font-medium student-email">@s.Email</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-4 hidden md:table-cell">
                            <p class="font-bold text-slate-800">@s.BatchName</p>
                            <p class="text-slate-400 font-medium">@s.ClassName &bull; @s.SubjectName</p>
                        </td>
                        <td class="px-4 py-4 text-slate-500 font-medium hidden sm:table-cell">
                            @s.EnrollmentDate.ToString("MMM d, yyyy")
                        </td>
                        <td class="px-4 py-4">
                            <div class="flex items-center gap-2">
                                <div class="w-20 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full @(s.AttendancePercentage >= 90 ? "bg-emerald-500" : s.AttendancePercentage >= 75 ? "bg-amber-500" : "bg-rose-500")" 
                                         style="width: @s.AttendancePercentage%;"></div>
                                </div>
                                <span class="font-extrabold @(s.AttendancePercentage >= 90 ? "text-emerald-600" : s.AttendancePercentage >= 75 ? "text-amber-600" : "text-rose-600")">
                                    @s.AttendancePercentage.ToString("F1")%
                                </span>
                            </div>
                        </td>
                        <td class="px-4 py-4">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-extrabold
                                @(s.Status == "Active" ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-600")">
                                <span class="w-1.5 h-1.5 rounded-full @(s.Status == "Active" ? "bg-emerald-500" : "bg-slate-400")"></span>
                                @s.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Students.Any())
    {
        <div class="text-center py-16 text-slate-400">
            <i class="fas fa-user-group text-4xl mb-3"></i>
            <h3 class="text-sm font-bold">No students enrolled yet</h3>
            <p class="text-xs mt-1">Students will appear here once they enroll in your batches</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Live search
        const studentSearchInput = document.getElementById('studentSearch');
        if (studentSearchInput) {
            studentSearchInput.addEventListener('input', (e) => {
                const q = e.target.value.toLowerCase();
                document.querySelectorAll('.student-row').forEach(row => {
                    const name = row.querySelector('.student-name')?.innerText.toLowerCase() || '';
                    const email = row.querySelector('.student-email')?.innerText.toLowerCase() || '';
                    row.style.display = (name.includes(q) || email.includes(q)) ? 'table-row' : 'none';
                });
            });
        }

        function exportToCSV() {
            const rows = [['#', 'Name', 'Email', 'Batch', 'Class', 'Subject', 'Attendance%', 'Status']];
            document.querySelectorAll('.student-row').forEach((row, idx) => {
                const name = row.querySelector('.student-name')?.innerText || '';
                const email = row.querySelector('.student-email')?.innerText || '';
                rows.push([idx + 1, name, email, '', '', '', '', '']);
            });
            const csvContent = rows.map(r => r.join(',')).join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv' });
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'students_roster.csv';
            a.click();
        }
    </script>
}
