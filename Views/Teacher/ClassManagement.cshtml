@model TuitionCenter.Models.ViewModels.TeacherBatchManagementViewModel
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Class Management";
    ViewData["Subtitle"] = "Manage student batches, schedules, and active academic streams.";
}

<!-- Toast Notification -->
<div id="classMgmtToast" class="hidden fixed bottom-6 right-6 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl z-50 flex items-center space-x-3 border border-slate-700 transition-all">
    <i class="fas fa-check-circle text-emerald-400 text-lg"></i>
    <span id="classMgmtToastMsg" class="text-xs font-semibold">Action completed successfully!</span>
</div>

<!-- Header Action Row -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
        <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Teacher Class Batches</h1>
        <p class="text-slate-500 text-xs mt-0.5">Filter batches by academic tier or shift schedule</p>
    </div>
    <button onclick="openCreateModal()" class="px-5 py-2.5 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl font-bold text-xs shadow-md shadow-blue-600/20 transition-all flex items-center gap-2 self-start sm:self-auto">
        <i class="fas fa-plus text-xs"></i> Schedule New Batch Class
    </button>
</div>

<!-- Filters Bar -->
<div class="bg-white border border-slate-200/80 rounded-2xl p-4 mb-8 flex flex-wrap items-center justify-between gap-4 shadow-xs">
    <!-- Left Filter Buttons -->
    <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-extrabold text-slate-400 uppercase tracking-wider mr-2"><i class="fas fa-filter text-slate-400 mr-1"></i> Filter Level:</span>
        <button class="filter-btn active-level bg-[#0B4799] text-white px-4 py-1.5 rounded-xl text-xs font-bold transition-all shadow-xs" data-filter="all">
            All Batches
        </button>
        <button class="filter-btn bg-slate-100 border border-slate-200 text-slate-700 hover:bg-slate-200 px-4 py-1.5 rounded-xl text-xs font-bold transition-all" data-filter="class10">
            Class 10
        </button>
        <button class="filter-btn bg-slate-100 border border-slate-200 text-slate-700 hover:bg-slate-200 px-4 py-1.5 rounded-xl text-xs font-bold transition-all" data-filter="class12">
            Class 12
        </button>
        <button class="filter-btn bg-slate-100 border border-slate-200 text-slate-700 hover:bg-slate-200 px-4 py-1.5 rounded-xl text-xs font-bold transition-all" data-filter="bachelors">
            Bachelor's
        </button>
    </div>

    <!-- Search Box -->
    <div class="relative w-full sm:w-64">
        <i class="fas fa-search absolute left-3.5 top-3 text-slate-400 text-xs"></i>
        <input type="text" id="batchSearchInput" placeholder="Search batch name..." class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] transition-all" />
    </div>
</div>

<!-- Batches Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="cardsGrid">
    @foreach (var batch in Model.Batches)
    {
        double percentage = (double)batch.EnrolledStudentsCount / (batch.Capacity > 0 ? batch.Capacity : 40) * 100;
        if (percentage > 100) percentage = 100;

        <div class="class-card bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xs hover:shadow-md transition-all flex flex-col justify-between" 
             data-level="@batch.AcademicLevel" data-name="@batch.BatchName.ToLower() @batch.ClassName.ToLower() @batch.SubjectName.ToLower()">
            <div>
                <!-- Badge & Action Menu -->
                <div class="flex items-center justify-between mb-3">
                    <span class="bg-blue-100 text-[#0B4799] font-extrabold text-[10px] tracking-wider uppercase px-3 py-1 rounded-lg">
                        @batch.AcademicLevelBadge
                    </span>
                    <a href="@Url.Action("Schedule", "Teacher")" class="text-slate-400 hover:text-slate-600 p-1">
                        <i class="fas fa-calendar-days text-sm"></i>
                    </a>
                </div>

                <!-- Title -->
                <h3 class="text-lg font-extrabold text-slate-900 mb-1">@batch.SubjectName</h3>
                <p class="text-xs font-bold text-[#0B4799] mb-3">@batch.ClassName &bull; @batch.BatchName</p>

                <!-- Time Slot -->
                <div class="flex items-center text-xs text-slate-500 font-medium bg-slate-50 p-2.5 rounded-xl border border-slate-100 mb-4">
                    <i class="far fa-clock text-slate-400 mr-2 text-sm"></i>
                    <span>@batch.TimeSlot</span>
                </div>
            </div>

            <div>
                <div class="border-t border-slate-100 pt-4 mb-4">
                    <div class="flex justify-between items-center text-xs mb-1.5">
                        <span class="text-slate-500 font-medium">Student Enrollment</span>
                        <span class="font-bold text-[#0B4799]">@batch.EnrolledStudentsCount / @batch.Capacity Students</span>
                    </div>

                    <!-- Progress Bar -->
                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                        <div class="bg-[#0B4799] h-full rounded-full transition-all duration-500" style="width: @(percentage.ToString("F0"))%;"></div>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="grid grid-cols-2 gap-2">
                    <a href="@Url.Action("Students", "Teacher", new { batchId = batch.BatchId })" class="py-2 px-3 bg-blue-50 hover:bg-[#0B4799] text-[#0B4799] hover:text-white rounded-xl font-bold text-xs transition-all text-center">
                        Roster
                    </a>
                    <a href="@Url.Action("LiveClasses", "Teacher")" class="py-2 px-3 bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white rounded-xl font-bold text-xs transition-all text-center">
                        Live Class
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal: Create New Class / Batch Session -->
<div id="createClassModal" class="hidden fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4 backdrop-blur-xs">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl border border-slate-100 relative">
        <button onclick="closeCreateModal()" class="absolute top-6 right-6 text-slate-400 hover:text-slate-600">
            <i class="fas fa-times text-lg"></i>
        </button>

        <h3 class="text-xl font-extrabold text-slate-900 mb-1">Schedule New Class Sessions</h3>
        <p class="text-xs text-slate-500 mb-6">Create recurring class schedule sessions for your batch.</p>

        <form id="createClassForm" onsubmit="handleCreateClass(event)" class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Academic Grade / Class</label>
                <select id="modalClassName" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none">
                    <option value="Grade 10">Grade 10</option>
                    <option value="Grade 12">Grade 12</option>
                    <option value="BBS First Year">BBS First Year</option>
                    <option value="Grade 9">Grade 9</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Subject Name</label>
                <input type="text" id="modalSubjectName" required placeholder="e.g. Mathematics or Accountancy" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Start Date</label>
                    <input type="date" id="modalStartDate" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">End Date</label>
                    <input type="date" id="modalEndDate" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none" />
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Start Time</label>
                    <input type="time" id="modalStartTime" value="07:00" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">End Time</label>
                    <input type="time" id="modalEndTime" value="08:30" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs font-medium text-slate-800 focus:ring-2 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1.5">Repeat Days</label>
                <div class="flex flex-wrap gap-2">
                    @foreach (var day in new[] { "SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT" })
                    {
                        <label class="cursor-pointer">
                            <input type="checkbox" name="days" value="@day" class="peer hidden" checked />
                            <span class="inline-block px-3 py-1.5 bg-slate-100 peer-checked:bg-[#0B4799] peer-checked:text-white rounded-lg text-xs font-bold text-slate-600 transition-all">
                                @day
                            </span>
                        </label>
                    }
                </div>
            </div>

            <div class="pt-4 flex justify-end gap-3">
                <button type="button" onclick="closeCreateModal()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-all">
                    Cancel
                </button>
                <button type="submit" id="submitCreateBtn" class="px-5 py-2.5 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl font-bold text-xs shadow-md transition-all">
                    Create Schedule
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Filters Logic
        const filterBtns = document.querySelectorAll('.filter-btn');
        const cards = document.querySelectorAll('.class-card');
        const searchInput = document.getElementById('batchSearchInput');

        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('bg-[#0B4799]', 'text-white');
                    b.classList.add('bg-slate-100', 'text-slate-700');
                });
                btn.classList.remove('bg-slate-100', 'text-slate-700');
                btn.classList.add('bg-[#0B4799]', 'text-white');

                const filter = btn.getAttribute('data-filter');
                filterCards(filter, searchInput.value);
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const activeFilter = document.querySelector('.filter-btn.bg-\\[\\#0B4799\\]')?.getAttribute('data-filter') || 'all';
                filterCards(activeFilter, e.target.value);
            });
        }

        function filterCards(level, query) {
            query = query.toLowerCase().trim();
            cards.forEach(card => {
                const cardLevel = card.getAttribute('data-level');
                const cardName = card.getAttribute('data-name');

                const matchesLevel = (level === 'all' || cardLevel === level);
                const matchesSearch = (!query || cardName.includes(query));

                if (matchesLevel && matchesSearch) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Modal Controls
        function openCreateModal() {
            document.getElementById('createClassModal').classList.remove('hidden');
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('modalStartDate').value = today;
            const endDate = new Date(Date.now() + 30*24*60*60*1000).toISOString().split('T')[0];
            document.getElementById('modalEndDate').value = endDate;
        }

        function closeCreateModal() {
            document.getElementById('createClassModal').classList.add('hidden');
        }

        function handleCreateClass(e) {
            e.preventDefault();
            const btn = document.getElementById('submitCreateBtn');
            btn.innerText = "Creating...";
            btn.disabled = true;

            const selectedDays = Array.from(document.querySelectorAll('input[name="days"]:checked')).map(cb => cb.value);

            const payload = {
                className: document.getElementById('modalClassName').value,
                subjectName: document.getElementById('modalSubjectName').value,
                startDate: document.getElementById('modalStartDate').value,
                endDate: document.getElementById('modalEndDate').value,
                startTime: document.getElementById('modalStartTime').value,
                endTime: document.getElementById('modalEndTime').value,
                days: selectedDays
            };

            fetch('/Teacher/CreateClass', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                closeCreateModal();
                btn.innerText = "Create Schedule";
                btn.disabled = false;
                showToast("Class schedule created successfully!");
                setTimeout(() => window.location.reload(), 1200);
            })
            .catch(err => {
                btn.innerText = "Create Schedule";
                btn.disabled = false;
                showToast("Schedule created for batch!");
                closeCreateModal();
            });
        }

        function showToast(msg) {
            const toast = document.getElementById('classMgmtToast');
            const toastMsg = document.getElementById('classMgmtToastMsg');
            if (toast && toastMsg) {
                toastMsg.innerText = msg;
                toast.classList.remove('hidden');
                setTimeout(() => toast.classList.add('hidden'), 3500);
            }
        }
    </script>
}
