@model TuitionCenter.Models.ViewModels.TeacherDashboardViewModel
@{
    Layout = null;
    ViewData["Title"] = "Class Management";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Study Point</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#0B4799',
                        secondary: '#4F81C7',
                        background: '#F9FAFB',
                        cardBg: '#F3F6FA',
                        textMain: '#1F2937',
                        textMuted: '#6B7280',
                        badgeGreen: '#34D399',
                        badgeSecondary: '#DDE5ED'
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F9FAFB; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col flex-shrink-0">
        <div class="p-6">
            <h1 class="text-2xl font-bold text-primary">Study <span class="text-secondary">Point</span></h1>
            <p class="text-xs text-gray-500 mt-1">Teacher Portal</p>
        </div>
        <nav class="flex-1 mt-4">
            <ul class="space-y-1">
                <li>
                    <a href="@Url.Action("Dashboard", "Teacher")" class="flex items-center px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors">
                        <i class="fas fa-th-large w-5 h-5 mr-3 text-lg"></i>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center px-6 py-3 text-primary bg-[#EBF3FF] border-l-4 border-primary font-medium">
                        <i class="fas fa-users w-5 h-5 mr-3 text-lg"></i>
                        Class Management
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Schedule", "Teacher")" class="flex items-center px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors">
                        <i class="far fa-calendar-alt w-5 h-5 mr-3 text-lg"></i>
                        Schedule
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("LiveClasses", "Teacher")" class="flex items-center px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors">
                        <i class="fas fa-video w-5 h-5 mr-3 text-lg"></i>
                        Live Classes
                    </a>
                </li>
                <li>
                    <a href="#" class="flex items-center px-6 py-3 text-gray-600 hover:bg-gray-50 hover:text-primary transition-colors">
                        <i class="far fa-user w-5 h-5 mr-3 text-lg"></i>
                        Profile
                    </a>
                </li>
            </ul>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-hidden">
        <!-- Top Navbar -->
        <header class="bg-white border-b border-gray-200 px-8 py-4 flex justify-between items-center flex-shrink-0">
            <div>
                <h2 class="text-xl font-bold text-gray-900">Class Management</h2>
                <p class="text-sm text-gray-500">Manage student batches and enrollment across academic levels.</p>
            </div>
            <div class="flex items-center space-x-6">
                <div class="relative">
                    <button id="notificationBtn" class="text-gray-500 hover:text-gray-700 relative p-1">
                        <i class="far fa-bell text-xl"></i>
                        <span id="notifBadge" class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>
                    <!-- Notification Dropdown -->
                    <div id="notificationDropdown" class="hidden absolute right-0 mt-2 w-80 bg-white rounded-2xl shadow-xl border border-gray-100 z-50 overflow-hidden">
                        <div class="flex justify-between items-center px-5 py-4 border-b border-gray-100">
                            <h4 class="text-sm font-bold text-gray-900">Notifications</h4>
                            <button id="markAllReadBtn" class="text-xs text-[#0B4799] font-semibold hover:underline">Mark all read</button>
                        </div>
                        <div class="max-h-72 overflow-y-auto divide-y divide-gray-50">
                            <div class="notif-item flex items-start gap-3 px-5 py-3.5 hover:bg-gray-50 cursor-pointer unread">
                                <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-calendar-check text-[#0B4799] text-xs"></i></div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-gray-900 leading-snug">Class session starting soon</p>
                                    <p class="text-xs text-gray-500 mt-0.5 truncate">Mathematics - Grade 10 · Batch A · 7:00 AM</p>
                                    <p class="text-[11px] text-gray-400 mt-1">5 minutes ago</p>
                                </div>
                                <span class="notif-dot w-2 h-2 rounded-full bg-[#0B4799] flex-shrink-0 mt-2"></span>
                            </div>
                            <div class="notif-item flex items-start gap-3 px-5 py-3.5 hover:bg-gray-50 cursor-pointer unread">
                                <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-user-plus text-green-600 text-xs"></i></div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-gray-900 leading-snug">New student enrolled</p>
                                    <p class="text-xs text-gray-500 mt-0.5 truncate">Priya Sharma joined Science - Grade 9</p>
                                    <p class="text-[11px] text-gray-400 mt-1">32 minutes ago</p>
                                </div>
                                <span class="notif-dot w-2 h-2 rounded-full bg-[#0B4799] flex-shrink-0 mt-2"></span>
                            </div>
                            <div class="notif-item flex items-start gap-3 px-5 py-3.5 hover:bg-gray-50 cursor-pointer">
                                <div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-link text-amber-600 text-xs"></i></div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-700 leading-snug">Reminder: Update live class link</p>
                                    <p class="text-xs text-gray-500 mt-0.5 truncate">Evening batch · Science - Grade 9 has no link</p>
                                    <p class="text-[11px] text-gray-400 mt-1">1 hour ago</p>
                                </div>
                            </div>
                            <div class="notif-item flex items-start gap-3 px-5 py-3.5 hover:bg-gray-50 cursor-pointer">
                                <div class="w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center flex-shrink-0 mt-0.5"><i class="fas fa-clipboard-check text-purple-600 text-xs"></i></div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-700 leading-snug">Attendance report ready</p>
                                    <p class="text-xs text-gray-500 mt-0.5 truncate">Weekly report for Accountancy - Grade 12</p>
                                    <p class="text-[11px] text-gray-400 mt-1">3 hours ago</p>
                                </div>
                            </div>
                        </div>
                        <div class="px-5 py-3 border-t border-gray-100 bg-gray-50">
                            <button class="w-full text-center text-xs font-semibold text-[#0B4799] hover:underline">View all notifications</button>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <img id="topProfileBtn" src="https://i.pravatar.cc/150?img=11" alt="Profile" class="w-10 h-10 rounded-full border-2 border-primary object-cover cursor-pointer hover:ring-2 hover:ring-primary hover:ring-offset-2 transition-all" />
                    
                    <!-- Dropdown Menu -->
                    <div id="topProfileDropdown" class="hidden absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-gray-100 py-2 z-50">
                        <div class="px-4 py-3 border-b border-gray-100">
                            <p class="text-sm font-semibold text-gray-900">@(Model?.TeacherName ?? "Teacher Portal")</p>
                            <p class="text-xs text-gray-500 truncate">@(Model?.TeacherEmail ?? "teacher@studypoint.com")</p>
                        </div>
                        <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-primary transition-colors">
                            <i class="far fa-user w-4 mr-2"></i> My Profile
                        </a>
                        <div class="border-t border-gray-100 my-1"></div>
                        <a href="@Url.Action("Logout", "Account")" class="block px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors">
                            <i class="fas fa-sign-out-alt w-4 mr-2"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Scrollable Content Area -->
        <div class="flex-1 overflow-y-auto p-8 bg-[#F9FAFB]">
            
            <!-- Filters Bar -->
            <div class="bg-white border border-gray-200 rounded-2xl px-6 py-3.5 mb-8 flex flex-wrap items-center gap-3 shadow-sm">
                <!-- Filters Label -->
                <div class="flex items-center text-gray-700 font-bold text-xs tracking-wider space-x-2 mr-1">
                    <i class="fas fa-sliders-h text-sm text-gray-700"></i>
                    <span class="tracking-widest">FILTERS</span>
                </div>

                <!-- Separator -->
                <div class="h-6 w-[1px] bg-gray-200 mx-1 hidden sm:block"></div>

                <!-- Academic Level Group -->
                <div class="flex flex-wrap items-center gap-2" id="levelFilterGroup">
                    <button class="filter-btn active-level bg-[#0B4799] text-white px-5 py-1.5 rounded-full text-sm font-medium transition-all shadow-sm" data-filter="all">
                        All Levels
                    </button>
                    <button class="filter-btn bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 px-4 py-1.5 rounded-full text-sm font-medium transition-all" data-filter="class10">
                        Class 10
                    </button>
                    <button class="filter-btn bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 px-4 py-1.5 rounded-full text-sm font-medium transition-all" data-filter="class12">
                        Class 12
                    </button>
                    <button class="filter-btn bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 px-4 py-1.5 rounded-full text-sm font-medium transition-all" data-filter="bachelors">
                        Bachelor's
                    </button>
                </div>

                <!-- Separator -->
                <div class="h-6 w-[1px] bg-gray-200 mx-1 hidden sm:block"></div>

                <!-- Timing Shift Group -->
                <div class="flex flex-wrap items-center gap-2" id="timeFilterGroup">
                    <button class="time-filter-btn bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 px-4 py-1.5 rounded-full text-sm font-medium transition-all" data-time="morning">
                        Morning
                    </button>
                    <button class="time-filter-btn bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 px-4 py-1.5 rounded-full text-sm font-medium transition-all" data-time="afternoon">
                        Afternoon
                    </button>
                    <button class="time-filter-btn bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 px-4 py-1.5 rounded-full text-sm font-medium transition-all" data-time="evening">
                        Evening
                    </button>
                </div>
            </div>

            <!-- Toast Notification -->
            <div id="toastNotification" class="hidden fixed bottom-6 right-6 bg-gray-900 text-white px-5 py-3 rounded-xl shadow-xl z-50 flex items-center space-x-3 border border-gray-700">
                <i class="fas fa-check-circle text-green-400 text-lg"></i>
                <span id="toastMessage" class="text-sm font-medium">Action completed successfully!</span>
            </div>

            <!-- Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="cardsGrid">
                
                <!-- Card 1: Accountancy - Grade 12 -->
                <div class="class-card bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow relative" data-level="class12" data-time="morning">
                    <div>
                        <!-- Top Header Row -->
                        <div class="flex justify-between items-center mb-3">
                            <span class="bg-[#34D399] text-gray-900 font-bold text-[11px] tracking-wider uppercase px-3 py-1 rounded-full">
                                HIGHER SECONDARY
                            </span>
                            <div class="relative">
                                <button class="card-options-btn text-gray-400 hover:text-gray-600 p-1 rounded-full">
                                    <i class="fas fa-ellipsis-v text-base"></i>
                                </button>
                                <div class="card-options-menu hidden absolute right-0 mt-1 w-36 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 z-20">
                                    <button class="w-full text-left px-4 py-1.5 text-xs text-gray-700 hover:bg-gray-50 flex items-center gap-2">
                                        <i class="far fa-edit text-gray-400"></i> Edit Batch
                                    </button>
                                    <button class="w-full text-left px-4 py-1.5 text-xs text-red-600 hover:bg-red-50 flex items-center gap-2 btn-delete-card">
                                        <i class="far fa-trash-alt text-red-500"></i> Delete Batch
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Title -->
                        <h3 class="text-xl font-bold text-gray-900 mb-1">Accountancy - Grade 12</h3>
                        
                        <!-- Schedule Info -->
                        <div class="flex items-center text-sm text-gray-600 font-medium mb-4">
                            <i class="far fa-clock text-gray-400 mr-2 text-sm"></i>
                            <span>Batch A | 7:00 AM - 8:30 AM</span>
                        </div>
                    </div>

                    <div>
                        <!-- Divider -->
                        <div class="border-b border-gray-100 my-4"></div>

                        <!-- Enrollment -->
                        <div class="flex justify-between items-center text-sm mb-2">
                            <span class="text-gray-500 font-medium">Enrollment</span>
                            <span class="font-bold text-[#0B4799]">42 / 50 Students</span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="w-full bg-[#E5EDFF] h-2.5 rounded-full overflow-hidden mb-6">
                            <div class="bg-[#0B4799] h-full rounded-full w-[84%]"></div>
                        </div>

                        <!-- Button -->
                        <button class="btn-view-students w-full py-2.5 rounded-xl border-2 border-[#0B4799] text-[#0B4799] font-bold text-sm hover:bg-[#0B4799] hover:text-white transition-all text-center" data-title="Accountancy - Grade 12">
                            View Students
                        </button>
                    </div>
                </div>

                <!-- Card 2: Mathematics - Grade 10 -->
                <div class="class-card bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow relative" data-level="class10" data-time="afternoon">
                    <div>
                        <!-- Top Header Row -->
                        <div class="flex justify-between items-center mb-3">
                            <span class="bg-[#DDE5ED] text-[#334155] font-bold text-[11px] tracking-wider uppercase px-3 py-1 rounded-md">
                                SECONDARY
                            </span>
                            <div class="relative">
                                <button class="card-options-btn text-gray-400 hover:text-gray-600 p-1 rounded-full">
                                    <i class="fas fa-ellipsis-v text-base"></i>
                                </button>
                                <div class="card-options-menu hidden absolute right-0 mt-1 w-36 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 z-20">
                                    <button class="w-full text-left px-4 py-1.5 text-xs text-gray-700 hover:bg-gray-50 flex items-center gap-2">
                                        <i class="far fa-edit text-gray-400"></i> Edit Batch
                                    </button>
                                    <button class="w-full text-left px-4 py-1.5 text-xs text-red-600 hover:bg-red-50 flex items-center gap-2 btn-delete-card">
                                        <i class="far fa-trash-alt text-red-500"></i> Delete Batch
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Title -->
                        <h3 class="text-xl font-bold text-gray-900 mb-1">Mathematics - Grade 10</h3>
                        
                        <!-- Schedule Info -->
                        <div class="flex items-center text-sm text-gray-600 font-medium mb-4">
                            <i class="far fa-clock text-gray-400 mr-2 text-sm"></i>
                            <span>Batch C | 4:30 PM - 6:00 PM</span>
                        </div>
                    </div>

                    <div>
                        <!-- Divider -->
                        <div class="border-b border-gray-100 my-4"></div>

                        <!-- Enrollment -->
                        <div class="flex justify-between items-center text-sm mb-2">
                            <span class="text-gray-500 font-medium">Enrollment</span>
                            <span class="font-bold text-[#0B4799]">31 / 40 Students</span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="w-full bg-[#E5EDFF] h-2.5 rounded-full overflow-hidden mb-6">
                            <div class="bg-[#0B4799] h-full rounded-full w-[77.5%]"></div>
                        </div>

                        <!-- Button -->
                        <button class="btn-view-students w-full py-2.5 rounded-xl border-2 border-[#0B4799] text-[#0B4799] font-bold text-sm hover:bg-[#0B4799] hover:text-white transition-all text-center" data-title="Mathematics - Grade 10">
                            View Students
                        </button>
                    </div>
                </div>

                <!-- Card 3: BBS - Financial Mgmt -->
                <div class="class-card bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow relative" data-level="bachelors" data-time="morning">
                    <div>
                        <!-- Top Header Row -->
                        <div class="flex justify-between items-center mb-3">
                            <span class="bg-[#34D399] text-gray-900 font-bold text-[11px] tracking-wider uppercase px-3 py-1 rounded-full">
                                UNIVERSITY
                            </span>
                            <div class="relative">
                                <button class="card-options-btn text-gray-400 hover:text-gray-600 p-1 rounded-full">
                                    <i class="fas fa-ellipsis-v text-base"></i>
                                </button>
                                <div class="card-options-menu hidden absolute right-0 mt-1 w-36 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 z-20">
                                    <button class="w-full text-left px-4 py-1.5 text-xs text-gray-700 hover:bg-gray-50 flex items-center gap-2">
                                        <i class="far fa-edit text-gray-400"></i> Edit Batch
                                    </button>
                                    <button class="w-full text-left px-4 py-1.5 text-xs text-red-600 hover:bg-red-50 flex items-center gap-2 btn-delete-card">
                                        <i class="far fa-trash-alt text-red-500"></i> Delete Batch
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Title -->
                        <h3 class="text-xl font-bold text-gray-900 mb-1">BBS - Financial Mgmt</h3>
                        
                        <!-- Schedule Info -->
                        <div class="flex items-center text-sm text-gray-600 font-medium mb-4">
                            <i class="far fa-clock text-gray-400 mr-2 text-sm"></i>
                            <span>Batch B | 6:30 AM - 8:00 AM</span>
                        </div>
                    </div>

                    <div>
                        <!-- Divider -->
                        <div class="border-b border-gray-100 my-4"></div>

                        <!-- Enrollment -->
                        <div class="flex justify-between items-center text-sm mb-2">
                            <span class="text-gray-500 font-medium">Enrollment</span>
                            <span class="font-bold text-[#0B4799]">18 / 25 Students</span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="w-full bg-[#E5EDFF] h-2.5 rounded-full overflow-hidden mb-6">
                            <div class="bg-[#0B4799] h-full rounded-full w-[72%]"></div>
                        </div>

                        <!-- Button -->
                        <button class="btn-view-students w-full py-2.5 rounded-xl border-2 border-[#0B4799] text-[#0B4799] font-bold text-sm hover:bg-[#0B4799] hover:text-white transition-all text-center" data-title="BBS - Financial Mgmt">
                            View Students
                        </button>
                    </div>
                </div>

                <!-- Card 4: Science - Grade 9 -->
                <div class="class-card bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow relative" data-level="secondary" data-time="evening">
                    <div>
                        <!-- Top Header Row -->
                        <div class="flex justify-between items-center mb-3">
                            <span class="bg-[#DDE5ED] text-[#334155] font-bold text-[11px] tracking-wider uppercase px-3 py-1 rounded-md">
                                SECONDARY
                            </span>
                            <div class="relative">
                                <button class="card-options-btn text-gray-400 hover:text-gray-600 p-1 rounded-full">
                                    <i class="fas fa-ellipsis-v text-base"></i>
                                </button>
                                <div class="card-options-menu hidden absolute right-0 mt-1 w-36 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 z-20">
                                    <button class="w-full text-left px-4 py-1.5 text-xs text-gray-700 hover:bg-gray-50 flex items-center gap-2">
                                        <i class="far fa-edit text-gray-400"></i> Edit Batch
                                    </button>
                                    <button class="w-full text-left px-4 py-1.5 text-xs text-red-600 hover:bg-red-50 flex items-center gap-2 btn-delete-card">
                                        <i class="far fa-trash-alt text-red-500"></i> Delete Batch
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Title -->
                        <h3 class="text-xl font-bold text-gray-900 mb-1">Science - Grade 9</h3>
                        
                        <!-- Schedule Info -->
                        <div class="flex items-center text-sm text-gray-600 font-medium mb-4">
                            <i class="far fa-clock text-gray-400 mr-2 text-sm"></i>
                            <span>Evening | 5:00 PM - 6:30 PM</span>
                        </div>
                    </div>

                    <div>
                        <!-- Divider -->
                        <div class="border-b border-gray-100 my-4"></div>

                        <!-- Enrollment -->
                        <div class="flex justify-between items-center text-sm mb-2">
                            <span class="text-gray-500 font-medium">Enrollment</span>
                            <span class="font-bold text-[#0B4799]">28 / 30 Students</span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="w-full bg-[#E5EDFF] h-2.5 rounded-full overflow-hidden mb-6">
                            <div class="bg-[#0B4799] h-full rounded-full w-[93.3%]"></div>
                        </div>

                        <!-- Button -->
                        <button class="btn-view-students w-full py-2.5 rounded-xl border-2 border-[#0B4799] text-[#0B4799] font-bold text-sm hover:bg-[#0B4799] hover:text-white transition-all text-center" data-title="Science - Grade 9">
                            View Students
                        </button>
                    </div>
                </div>

                <!-- Card 5: Add New Batch (Interactive Trigger) -->
                <div id="openAddBatchModalCard" class="bg-[#F0F4FA] border-2 border-dashed border-[#A0C0F0] rounded-2xl p-8 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-[#E6EEF9] transition-all min-h-[290px] group">
                    <div class="w-12 h-12 rounded-full border-2 border-[#0B4799] text-[#0B4799] flex items-center justify-center mb-4 bg-white shadow-sm group-hover:scale-110 transition-transform">
                        <i class="fas fa-plus text-base font-bold"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-1">Add New Batch</h3>
                    <p class="text-sm text-gray-500 max-w-[220px] leading-relaxed">
                        Click to expand your curriculum and manage more students
                    </p>
                </div>

            </div>
        </div>
    </main>

    <!-- Modal 1: Add New Batch Modal -->
    <div id="addBatchModal" class="hidden fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 relative animate-in fade-in zoom-in duration-200">
            <div class="flex justify-between items-center pb-4 border-b border-gray-100">
                <h3 class="text-lg font-bold text-gray-900">Add New Student Batch</h3>
                <button id="closeAddBatchModal" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>
            
            <form id="addBatchForm" class="mt-4 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Subject & Grade Title</label>
                    <input type="text" id="batchTitleInput" required placeholder="e.g. Chemistry - Grade 11" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Academic Category</label>
                        <select id="batchCategoryInput" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:border-primary">
                            <option value="HIGHER SECONDARY">HIGHER SECONDARY</option>
                            <option value="SECONDARY">SECONDARY</option>
                            <option value="UNIVERSITY">UNIVERSITY</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Filter Level</label>
                        <select id="batchLevelFilterInput" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:border-primary">
                            <option value="class12">Class 12</option>
                            <option value="class10">Class 10</option>
                            <option value="bachelors">Bachelor's</option>
                            <option value="secondary">Secondary</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Time Shift</label>
                        <select id="batchShiftInput" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:border-primary">
                            <option value="morning">Morning</option>
                            <option value="afternoon">Afternoon</option>
                            <option value="evening">Evening</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Time Slot Details</label>
                        <input type="text" id="batchTimeInput" required placeholder="Batch B | 8:00 AM - 9:30 AM" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:border-primary" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Enrolled Students</label>
                        <input type="number" id="batchEnrolledInput" required value="20" min="0" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:border-primary" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Max Capacity</label>
                        <input type="number" id="batchCapacityInput" required value="40" min="1" class="w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm outline-none focus:border-primary" />
                    </div>
                </div>

                <div class="pt-3 flex space-x-3">
                    <button type="button" id="cancelAddBatchModal" class="w-1/2 py-2.5 rounded-xl border border-gray-300 text-gray-700 font-bold text-sm hover:bg-gray-50 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="w-1/2 py-2.5 rounded-xl bg-[#0B4799] hover:bg-[#003E96] text-white font-bold text-sm shadow-md transition-colors">
                        Create Batch
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal 2: View Students Modal -->
    <div id="viewStudentsModal" class="hidden fixed inset-0 bg-gray-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-gray-100 relative">
            <div class="flex justify-between items-center pb-4 border-b border-gray-100">
                <div>
                    <h3 class="text-lg font-bold text-gray-900" id="studentsModalTitle">Enrolled Students</h3>
                    <p class="text-xs text-gray-500 mt-0.5">Active batch roster & attendance tracking</p>
                </div>
                <button id="closeStudentsModal" class="text-gray-400 hover:text-gray-600 p-1">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>

            <div class="mt-4 max-h-80 overflow-y-auto space-y-3 pr-1" id="studentsListContainer">
                <!-- Dynamically Populated Students -->
                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl">
                    <div class="flex items-center space-x-3">
                        <img src="https://i.pravatar.cc/150?img=33" alt="Student" class="w-9 h-9 rounded-full object-cover border border-primary/20" />
                        <div>
                            <p class="text-sm font-semibold text-gray-900">Aayush Sharma</p>
                            <p class="text-xs text-gray-500">Roll: #101 • Attendance: 96%</p>
                        </div>
                    </div>
                    <span class="bg-green-100 text-green-800 font-bold text-[11px] px-2.5 py-0.5 rounded-full">Present</span>
                </div>

                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl">
                    <div class="flex items-center space-x-3">
                        <img src="https://i.pravatar.cc/150?img=44" alt="Student" class="w-9 h-9 rounded-full object-cover border border-primary/20" />
                        <div>
                            <p class="text-sm font-semibold text-gray-900">Sneha Adhikari</p>
                            <p class="text-xs text-gray-500">Roll: #102 • Attendance: 92%</p>
                        </div>
                    </div>
                    <span class="bg-green-100 text-green-800 font-bold text-[11px] px-2.5 py-0.5 rounded-full">Present</span>
                </div>

                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl">
                    <div class="flex items-center space-x-3">
                        <img src="https://i.pravatar.cc/150?img=52" alt="Student" class="w-9 h-9 rounded-full object-cover border border-primary/20" />
                        <div>
                            <p class="text-sm font-semibold text-gray-900">Rohan Shrestha</p>
                            <p class="text-xs text-gray-500">Roll: #103 • Attendance: 88%</p>
                        </div>
                    </div>
                    <span class="bg-blue-100 text-blue-800 font-bold text-[11px] px-2.5 py-0.5 rounded-full">Active</span>
                </div>
            </div>

            <div class="pt-4 border-t border-gray-100 mt-4 flex justify-end">
                <button id="closeStudentsModalBtn" class="px-5 py-2 rounded-xl bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-sm transition-colors">
                    Close Window
                </button>
            </div>
        </div>
    </div>

    <!-- Interactive JavaScript -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            let activeLevel = 'all';
            let activeTime = null;

            // Profile dropdown toggle
            const topProfileBtn = document.getElementById('topProfileBtn');
            const topProfileDropdown = document.getElementById('topProfileDropdown');
            if (topProfileBtn && topProfileDropdown) {
                topProfileBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    topProfileDropdown.classList.toggle('hidden');
                });
                document.addEventListener('click', function() {
                    topProfileDropdown.classList.add('hidden');
                });
            }

            // Filtering Function
            function applyFilters() {
                const cards = document.querySelectorAll('.class-card');
                cards.forEach(card => {
                    const cardLevel = card.getAttribute('data-level');
                    const cardTime = card.getAttribute('data-time');

                    const levelMatch = (activeLevel === 'all' || cardLevel === activeLevel);
                    const timeMatch = (!activeTime || cardTime === activeTime);

                    if (levelMatch && timeMatch) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            }

            // Level Filter Pills
            const levelBtns = document.querySelectorAll('.filter-btn');
            levelBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    levelBtns.forEach(b => {
                        b.classList.remove('bg-[#0B4799]', 'text-white', 'shadow-sm');
                        b.classList.add('bg-white', 'border', 'border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
                    });
                    this.classList.remove('bg-white', 'border', 'border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
                    this.classList.add('bg-[#0B4799]', 'text-white', 'shadow-sm');

                    activeLevel = this.getAttribute('data-filter') || 'all';
                    applyFilters();
                });
            });

            // Time Filter Pills
            const timeBtns = document.querySelectorAll('.time-filter-btn');
            timeBtns.forEach(btn => {
                btn.addEventListener('click', function() {
                    const isSelected = this.classList.contains('bg-[#0B4799]');
                    timeBtns.forEach(b => {
                        b.classList.remove('bg-[#0B4799]', 'text-white', 'shadow-sm');
                        b.classList.add('bg-white', 'border', 'border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
                    });
                    if (!isSelected) {
                        this.classList.remove('bg-white', 'border', 'border-gray-300', 'text-gray-700', 'hover:bg-gray-50');
                        this.classList.add('bg-[#0B4799]', 'text-white', 'shadow-sm');
                        activeTime = this.getAttribute('data-time');
                    } else {
                        activeTime = null;
                    }
                    applyFilters();
                });
            });

            // Add New Batch Modal Logic
            const openAddBatchModalCard = document.getElementById('openAddBatchModalCard');
            const addBatchModal = document.getElementById('addBatchModal');
            const closeAddBatchModal = document.getElementById('closeAddBatchModal');
            const cancelAddBatchModal = document.getElementById('cancelAddBatchModal');
            const addBatchForm = document.getElementById('addBatchForm');
            const cardsGrid = document.getElementById('cardsGrid');

            if (openAddBatchModalCard && addBatchModal) {
                openAddBatchModalCard.addEventListener('click', function() {
                    addBatchModal.classList.remove('hidden');
                });

                const closeModalHandler = () => addBatchModal.classList.add('hidden');
                if (closeAddBatchModal) closeAddBatchModal.addEventListener('click', closeModalHandler);
                if (cancelAddBatchModal) cancelAddBatchModal.addEventListener('click', closeModalHandler);

                if (addBatchForm) {
                    addBatchForm.addEventListener('submit', function(e) {
                        e.preventDefault();
                        const title = document.getElementById('batchTitleInput').value.trim();
                        const category = document.getElementById('batchCategoryInput').value;
                        const levelFilter = document.getElementById('batchLevelFilterInput').value;
                        const shift = document.getElementById('batchShiftInput').value;
                        const timeSlot = document.getElementById('batchTimeInput').value.trim();
                        const enrolled = parseInt(document.getElementById('batchEnrolledInput').value) || 0;
                        const capacity = parseInt(document.getElementById('batchCapacityInput').value) || 40;

                        const pct = Math.min(100, Math.round((enrolled / capacity) * 100));

                        // Badge color mapping
                        const isGreenBadge = category === 'HIGHER SECONDARY' || category === 'UNIVERSITY';
                        const badgeBgClass = isGreenBadge ? 'bg-[#34D399] text-gray-900 font-bold' : 'bg-[#DDE5ED] text-[#334155] font-bold';
                        const badgeShape = isGreenBadge ? 'rounded-full' : 'rounded-md';

                        const newCard = document.createElement('div');
                        newCard.className = 'class-card bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow relative';
                        newCard.setAttribute('data-level', levelFilter);
                        newCard.setAttribute('data-time', shift);

                        newCard.innerHTML = `
                            <div>
                                <div class="flex justify-between items-center mb-3">
                                    <span class="${badgeBgClass} text-[11px] tracking-wider uppercase px-3 py-1 ${badgeShape}">
                                        ${category}
                                    </span>
                                    <div class="relative">
                                        <button class="card-options-btn text-gray-400 hover:text-gray-600 p-1 rounded-full">
                                            <i class="fas fa-ellipsis-v text-base"></i>
                                        </button>
                                        <div class="card-options-menu hidden absolute right-0 mt-1 w-36 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 z-20">
                                            <button class="w-full text-left px-4 py-1.5 text-xs text-gray-700 hover:bg-gray-50 flex items-center gap-2">
                                                <i class="far fa-edit text-gray-400"></i> Edit Batch
                                            </button>
                                            <button class="w-full text-left px-4 py-1.5 text-xs text-red-600 hover:bg-red-50 flex items-center gap-2 btn-delete-card">
                                                <i class="far fa-trash-alt text-red-500"></i> Delete Batch
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <h3 class="text-xl font-bold text-gray-900 mb-1">${title}</h3>
                                <div class="flex items-center text-sm text-gray-600 font-medium mb-4">
                                    <i class="far fa-clock text-gray-400 mr-2 text-sm"></i>
                                    <span>${timeSlot}</span>
                                </div>
                            </div>
                            <div>
                                <div class="border-b border-gray-100 my-4"></div>
                                <div class="flex justify-between items-center text-sm mb-2">
                                    <span class="text-gray-500 font-medium">Enrollment</span>
                                    <span class="font-bold text-[#0B4799]">${enrolled} / ${capacity} Students</span>
                                </div>
                                <div class="w-full bg-[#E5EDFF] h-2.5 rounded-full overflow-hidden mb-6">
                                    <div class="bg-[#0B4799] h-full rounded-full" style="width: ${pct}%"></div>
                                </div>
                                <button class="btn-view-students w-full py-2.5 rounded-xl border-2 border-[#0B4799] text-[#0B4799] font-bold text-sm hover:bg-[#0B4799] hover:text-white transition-all text-center" data-title="${title}">
                                    View Students
                                </button>
                            </div>
                        `;

                        cardsGrid.insertBefore(newCard, openAddBatchModalCard);
                        bindCardEvents(newCard);

                        addBatchModal.classList.add('hidden');
                        addBatchForm.reset();
                        showToast(`New batch "${title}" created successfully!`);
                        applyFilters();
                    });
                }
            }

            // View Students Modal Logic
            const viewStudentsModal = document.getElementById('viewStudentsModal');
            const closeStudentsModal = document.getElementById('closeStudentsModal');
            const closeStudentsModalBtn = document.getElementById('closeStudentsModalBtn');
            const studentsModalTitle = document.getElementById('studentsModalTitle');

            function openStudentsModal(title) {
                if (studentsModalTitle) studentsModalTitle.textContent = `Enrolled Students - ${title}`;
                if (viewStudentsModal) viewStudentsModal.classList.remove('hidden');
            }

            if (closeStudentsModal) closeStudentsModal.addEventListener('click', () => viewStudentsModal.classList.add('hidden'));
            if (closeStudentsModalBtn) closeStudentsModalBtn.addEventListener('click', () => viewStudentsModal.classList.add('hidden'));

            // Card Option Dropdowns & Delete Action Binding
            function bindCardEvents(card) {
                const optBtn = card.querySelector('.card-options-btn');
                const optMenu = card.querySelector('.card-options-menu');
                const deleteBtn = card.querySelector('.btn-delete-card');
                const viewStudentsBtn = card.querySelector('.btn-view-students');

                if (optBtn && optMenu) {
                    optBtn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        document.querySelectorAll('.card-options-menu').forEach(m => {
                            if (m !== optMenu) m.classList.add('hidden');
                        });
                        optMenu.classList.toggle('hidden');
                    });
                }

                if (deleteBtn) {
                    deleteBtn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        const titleEl = card.querySelector('h3');
                        const batchTitle = titleEl ? titleEl.textContent : 'Batch';
                        card.remove();
                        showToast(`Batch "${batchTitle}" deleted.`);
                    });
                }

                if (viewStudentsBtn) {
                    viewStudentsBtn.addEventListener('click', function() {
                        const title = this.getAttribute('data-title') || 'Selected Batch';
                        openStudentsModal(title);
                    });
                }
            }

            // Bind existing cards
            document.querySelectorAll('.class-card').forEach(bindCardEvents);

            // Close card options on global click
            document.addEventListener('click', function() {
                document.querySelectorAll('.card-options-menu').forEach(m => m.classList.add('hidden'));
            });

            // Toast helper
            function showToast(message) {
                const toast = document.getElementById('toastNotification');
                const toastMsg = document.getElementById('toastMessage');
                if (toast && toastMsg) {
                    toastMsg.textContent = message;
                    toast.classList.remove('hidden');
                    setTimeout(() => {
                        toast.classList.add('hidden');
                    }, 3000);
                }
            }
            // Notification dropdown
            const notificationBtn = document.getElementById('notificationBtn');
            const notificationDropdown = document.getElementById('notificationDropdown');
            const markAllReadBtn = document.getElementById('markAllReadBtn');
            const notifBadge = document.getElementById('notifBadge');
            if (notificationBtn && notificationDropdown) {
                notificationBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    notificationDropdown.classList.toggle('hidden');
                    if (topProfileDropdown) topProfileDropdown.classList.add('hidden');
                });
                if (markAllReadBtn) {
                    markAllReadBtn.addEventListener('click', function(e) {
                        e.stopPropagation();
                        document.querySelectorAll('.notif-dot').forEach(d => d.classList.add('hidden'));
                        document.querySelectorAll('.notif-item.unread').forEach(i => i.classList.remove('unread'));
                        if (notifBadge) notifBadge.classList.add('hidden');
                    });
                }
                document.querySelectorAll('.notif-item').forEach(function(item) {
                    item.addEventListener('click', function() {
                        const dot = this.querySelector('.notif-dot');
                        if (dot) dot.classList.add('hidden');
                        this.classList.remove('unread');
                        if (!document.querySelector('.notif-dot:not(.hidden)') && notifBadge) {
                            notifBadge.classList.add('hidden');
                        }
                    });
                });
                document.addEventListener('click', function(e) {
                    if (!notificationBtn.contains(e.target) && !notificationDropdown.contains(e.target)) {
                        notificationDropdown.classList.add('hidden');
                    }
                });
            }
        });
    </script>
</body>
</html>
