@model TuitionCenter.Models.ViewModels.TeacherScheduleViewModel
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Weekly Schedule";
    ViewData["Subtitle"] = "View and manage your weekly teaching calendar and timetable.";
}

<!-- Toast Notification -->
<div id="scheduleToast" class="hidden fixed bottom-6 right-6 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl z-50 flex items-center space-x-3 border border-slate-700 transition-all">
    <i class="fas fa-check-circle text-emerald-400 text-lg"></i>
    <span id="scheduleToastMsg" class="text-xs font-semibold">Action completed successfully!</span>
</div>

<!-- Calendar Header Row -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
    <div>
        <h1 class="text-xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
            <i class="fas fa-calendar-week text-[#0B4799]"></i> @Model.WeekDateRangeDisplay
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">Showing scheduled class lectures and interactive sessions</p>
    </div>

    <!-- Week Navigation Controls -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
        <a href="@Url.Action("Schedule", "Teacher", new { startDate = Model.CurrentWeekStart.AddDays(-7) })" 
           class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-all flex items-center gap-1">
            <i class="fas fa-chevron-left text-[10px]"></i> Prev Week
        </a>
        <a href="@Url.Action("Schedule", "Teacher")" 
           class="px-4 py-2 bg-blue-50 text-[#0B4799] hover:bg-[#0B4799] hover:text-white rounded-xl font-bold text-xs transition-all">
            This Week
        </a>
        <a href="@Url.Action("Schedule", "Teacher", new { startDate = Model.CurrentWeekStart.AddDays(7) })" 
           class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-all flex items-center gap-1">
            Next Week <i class="fas fa-chevron-right text-[10px]"></i>
        </a>
    </div>
</div>

<!-- Weekly Days Grid -->
<div class="grid grid-cols-1 md:grid-cols-7 gap-4 mb-8">
    @foreach (var day in Model.Days)
    {
        <div class="bg-white rounded-2xl border @(day.IsToday ? "border-[#0B4799] ring-2 ring-blue-500/20 shadow-md" : "border-slate-200/80 shadow-xs") flex flex-col min-h-[360px] overflow-hidden">
            <!-- Day Header -->
            <div class="p-3.5 text-center border-b border-slate-100 @(day.IsToday ? "bg-[#0B4799] text-white" : "bg-slate-50 text-slate-700")">
                <p class="text-[10px] font-extrabold tracking-wider uppercase opacity-80">@day.DayOfWeek</p>
                <h3 class="text-xl font-extrabold leading-none mt-1">@day.DayOfMonth</h3>
                @if (day.IsToday)
                {
                    <span class="inline-block bg-white/20 text-white text-[9px] font-bold px-2 py-0.5 rounded-md uppercase mt-1">
                        Today
                    </span>
                }
            </div>

            <!-- Sessions List for Day -->
            <div class="p-3 space-y-2.5 flex-1 overflow-y-auto">
                @if (day.Sessions.Any())
                {
                    foreach (var s in day.Sessions)
                    {
                        <div class="p-3 rounded-xl @s.ColorTheme shadow-sm hover:opacity-95 transition-all cursor-pointer group"
                             onclick="openSessionModal('@s.Title', '@s.ClassName', '@s.SubjectName', '@s.StartTime.ToString("hh:mm tt")', '@s.EndTime.ToString("hh:mm tt")')">
                            <p class="text-[10px] font-bold opacity-90 flex items-center gap-1">
                                <i class="far fa-clock text-[9px]"></i> @s.StartTime.ToString("hh:mm tt") - @s.EndTime.ToString("hh:mm tt")
                            </p>
                            <h4 class="text-xs font-extrabold mt-1 leading-snug group-hover:underline">@s.Title</h4>
                            <div class="flex items-center justify-between text-[10px] opacity-90 mt-2 pt-1 border-t border-white/20">
                                <span class="font-medium">@s.ClassName</span>
                                <i class="fas fa-[#0B4799] fa-arrow-right text-[8px] group-hover:translate-x-0.5 transition-transform"></i>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-8 text-slate-300 text-[11px] font-medium italic">
                        No sessions
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Modal: Session Info -->
<div id="sessionModal" class="hidden fixed inset-0 bg-slate-900/60 z-50 flex items-center justify-center p-4 backdrop-blur-xs">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 relative">
        <button onclick="closeSessionModal()" class="absolute top-5 right-5 text-slate-400 hover:text-slate-600">
            <i class="fas fa-times text-lg"></i>
        </button>

        <div class="w-12 h-12 rounded-2xl bg-blue-100 text-[#0B4799] flex items-center justify-center text-xl font-bold mb-3">
            <i class="fas fa-chalkboard"></i>
        </div>

        <h3 id="modalSessionTitle" class="text-lg font-extrabold text-slate-900 leading-snug mb-1">Class Session Details</h3>
        <p id="modalSessionGrade" class="text-xs font-bold text-[#0B4799] mb-4">Grade & Subject</p>

        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 space-y-2 mb-5 text-xs text-slate-600">
            <div class="flex justify-between">
                <span class="font-semibold text-slate-400">Time Window:</span>
                <span id="modalSessionTime" class="font-bold text-slate-800">10:00 AM - 11:30 AM</span>
            </div>
            <div class="flex justify-between">
                <span class="font-semibold text-slate-400">Class Room:</span>
                <span class="font-bold text-slate-800">Online Live Room</span>
            </div>
            <div class="flex justify-between">
                <span class="font-semibold text-slate-400">Default Link:</span>
                <span class="font-bold text-blue-600 hover:underline cursor-pointer" onclick="copyMeetingLink('https://meet.google.com/demo-session')">Copy Link</span>
            </div>
        </div>

        <div class="flex gap-3">
            <a href="@Url.Action("LiveClasses", "Teacher")" class="flex-1 text-center py-2.5 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl font-bold text-xs transition-all shadow-md">
                Launch Meeting
            </a>
            <button onclick="closeSessionModal()" class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-all">
                Close
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openSessionModal(title, grade, subject, start, end) {
            document.getElementById('modalSessionTitle').innerText = title;
            document.getElementById('modalSessionGrade').innerText = grade + " • " + subject;
            document.getElementById('modalSessionTime').innerText = start + " - " + end;
            document.getElementById('sessionModal').classList.remove('hidden');
        }

        function closeSessionModal() {
            document.getElementById('sessionModal').classList.add('hidden');
        }

        function copyMeetingLink(link) {
            navigator.clipboard.writeText(link).then(() => {
                const toast = document.getElementById('scheduleToast');
                const msg = document.getElementById('scheduleToastMsg');
                if (toast && msg) {
                    msg.innerText = "Meeting link copied!";
                    toast.classList.remove('hidden');
                    setTimeout(() => toast.classList.add('hidden'), 3000);
                }
            });
        }
    </script>
}
