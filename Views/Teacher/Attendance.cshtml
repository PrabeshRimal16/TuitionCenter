@model TuitionCenter.Models.ViewModels.TeacherAttendanceViewModel
@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Attendance";
    ViewData["Subtitle"] = "Mark and track student attendance for your class sessions.";
}

<!-- Toast Notification -->
<div id="attendanceToast" class="hidden fixed bottom-6 right-6 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl z-50 flex items-center space-x-3 border border-slate-700">
    <i class="fas fa-check-circle text-emerald-400 text-lg"></i>
    <span id="attendanceToastMsg" class="text-xs font-semibold">Attendance saved!</span>
</div>

<!-- Session Info Header -->
<div class="bg-gradient-to-br from-[#0B4799] to-[#1E3A8A] rounded-2xl p-6 mb-6 text-white shadow-lg shadow-blue-900/10 relative overflow-hidden">
    <div class="absolute -right-6 -bottom-6 w-40 h-40 bg-white/5 rounded-full blur-2xl pointer-events-none"></div>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative z-10">
        <div>
            <span class="text-[10px] font-extrabold uppercase tracking-widest text-blue-200">Attendance Session</span>
            <h2 class="text-xl font-extrabold mt-1 leading-tight">@Model.SessionTitle</h2>
            <p class="text-blue-100 text-xs font-medium mt-1 flex items-center gap-2">
                <i class="fas fa-layer-group text-blue-300"></i> @Model.BatchName
                &bull;
                <i class="far fa-calendar text-blue-300"></i> @Model.SessionDate.ToString("dddd, MMM d, yyyy")
            </p>
        </div>

        <!-- Session Selector Dropdown -->
        <div class="sm:text-right">
            <label class="block text-[10px] font-bold text-blue-200 uppercase tracking-wider mb-1">Switch Session</label>
            <select onchange="if(this.value) window.location.href='/Teacher/Attendance?sessionId=' + this.value"
                    class="bg-white/10 border border-white/20 text-white font-bold text-xs px-3 py-2 rounded-xl backdrop-blur-sm focus:outline-none focus:border-white/40 cursor-pointer">
                @foreach (var s in Model.TeacherSessions)
                {
                    <option value="@s.SessionId" @(s.SessionId == Model.SelectedSessionId ? "selected" : "") class="text-slate-900">
                        @s.Title (@s.StartTime.ToString("hh:mm tt"))
                    </option>
                }
            </select>
        </div>
    </div>
</div>

<!-- Attendance Stats Row -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    @{
        int totalStudents = Model.EnrolledStudents.Count;
        int presentCount = Model.EnrolledStudents.Count(s => s.IsPresent);
        int absentCount = totalStudents - presentCount;
        double presentPct = totalStudents > 0 ? (double)presentCount / totalStudents * 100 : 0;
    }
    <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-xs text-center">
        <p class="text-[10px] font-extrabold text-slate-400 uppercase tracking-wider mb-1">Total</p>
        <h3 class="text-2xl font-extrabold text-slate-900" id="statTotal">@totalStudents</h3>
        <p class="text-[10px] text-slate-400 font-medium">Students</p>
    </div>
    <div class="bg-white rounded-2xl p-4 border border-emerald-200/80 shadow-xs text-center ring-1 ring-emerald-100">
        <p class="text-[10px] font-extrabold text-emerald-500 uppercase tracking-wider mb-1">Present</p>
        <h3 class="text-2xl font-extrabold text-emerald-700" id="statPresent">@presentCount</h3>
        <p class="text-[10px] text-emerald-400 font-medium">Marked In</p>
    </div>
    <div class="bg-white rounded-2xl p-4 border border-rose-200/80 shadow-xs text-center ring-1 ring-rose-100">
        <p class="text-[10px] font-extrabold text-rose-500 uppercase tracking-wider mb-1">Absent</p>
        <h3 class="text-2xl font-extrabold text-rose-700" id="statAbsent">@absentCount</h3>
        <p class="text-[10px] text-rose-400 font-medium">Not Present</p>
    </div>
    <div class="bg-white rounded-2xl p-4 border border-blue-200/80 shadow-xs text-center ring-1 ring-blue-100">
        <p class="text-[10px] font-extrabold text-[#0B4799] uppercase tracking-wider mb-1">Rate</p>
        <h3 class="text-2xl font-extrabold text-[#0B4799]" id="statRate">@presentPct.ToString("F0")%</h3>
        <p class="text-[10px] text-blue-400 font-medium">Attendance</p>
    </div>
</div>

<!-- Mark Attendance Card -->
<div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 border-b border-slate-100 bg-slate-50/50">
        <h3 class="text-sm font-extrabold text-slate-900 flex items-center gap-2">
            <i class="fas fa-clipboard-check text-[#0B4799]"></i> Student Attendance Sheet
        </h3>

        <!-- Bulk Actions -->
        <div class="flex items-center gap-2">
            <button onclick="markAll(true)" class="px-3.5 py-2 bg-emerald-100 hover:bg-emerald-200 text-emerald-700 rounded-xl text-xs font-extrabold transition-all">
                <i class="fas fa-check mr-1"></i> All Present
            </button>
            <button onclick="markAll(false)" class="px-3.5 py-2 bg-rose-100 hover:bg-rose-200 text-rose-700 rounded-xl text-xs font-extrabold transition-all">
                <i class="fas fa-times mr-1"></i> All Absent
            </button>
            <button onclick="saveAttendance()" class="px-4 py-2 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl text-xs font-extrabold shadow-md shadow-blue-600/20 transition-all">
                <i class="fas fa-save mr-1"></i> Save Attendance
            </button>
        </div>
    </div>

    <div class="divide-y divide-slate-100" id="attendanceList">
        @for (int i = 0; i < Model.EnrolledStudents.Count; i++)
        {
            var stu = Model.EnrolledStudents[i];
            string initial = stu.FullName.Length > 0 ? stu.FullName[0].ToString().ToUpper() : "S";
            string[] avatarColors = { "bg-blue-100 text-blue-700", "bg-emerald-100 text-emerald-700", "bg-purple-100 text-purple-700", "bg-amber-100 text-amber-700", "bg-rose-100 text-rose-700" };
            string avatarColor = avatarColors[i % avatarColors.Length];

            <div class="attendance-row flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 hover:bg-slate-50/70 transition-colors"
                 data-student-id="@stu.StudentId" data-present="@(stu.IsPresent ? "true" : "false")">
                <!-- Student Info -->
                <div class="flex items-center gap-3 flex-1 min-w-0">
                    <div class="w-10 h-10 rounded-xl @avatarColor flex items-center justify-center font-extrabold text-sm flex-shrink-0">
                        @initial
                    </div>
                    <div class="min-w-0">
                        <p class="font-extrabold text-slate-900 text-xs">@stu.FullName</p>
                        <p class="text-slate-400 font-medium text-[11px]">@stu.RollNo &bull; @stu.Email</p>
                    </div>
                </div>

                <!-- Toggle & Remarks -->
                <div class="flex items-center gap-3 self-end sm:self-auto flex-shrink-0">
                    <input type="text" placeholder="Remarks (optional)" value="@stu.Remarks"
                           class="remarks-input w-36 bg-slate-50 border border-slate-200 rounded-lg px-2.5 py-1.5 text-[11px] font-medium text-slate-600 focus:ring-1 focus:ring-blue-500/20 focus:border-[#0B4799] outline-none" />

                    <!-- Present / Absent Toggle -->
                    <button class="attendance-toggle px-5 py-2 rounded-xl font-extrabold text-xs transition-all @(stu.IsPresent ? "bg-emerald-100 text-emerald-700 hover:bg-emerald-200" : "bg-rose-100 text-rose-700 hover:bg-rose-200")"
                            onclick="toggleAttendance(this)">
                        @if (stu.IsPresent)
                        {
                            <span><i class="fas fa-check mr-1.5"></i> Present</span>
                        }
                        else
                        {
                            <span><i class="fas fa-times mr-1.5"></i> Absent</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>

    @if (!Model.EnrolledStudents.Any())
    {
        <div class="text-center py-16 text-slate-400">
            <i class="fas fa-user-group text-4xl mb-3"></i>
            <h3 class="text-sm font-bold">No students found for this session</h3>
        </div>
    }

    <!-- Bottom Save Bar -->
    @if (Model.EnrolledStudents.Any())
    {
        <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
            <p class="text-xs text-slate-500 font-medium">
                <span class="font-extrabold text-[#0B4799]" id="bottomPresentCount">@presentCount</span> of
                <span class="font-extrabold">@totalStudents</span> students marked as present
            </p>
            <button onclick="saveAttendance()" class="px-5 py-2.5 bg-[#0B4799] hover:bg-[#083777] text-white rounded-xl text-xs font-extrabold shadow-md shadow-blue-600/20 transition-all flex items-center gap-2">
                <i class="fas fa-check-double"></i> Submit Attendance
            </button>
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleAttendance(btn) {
            const row = btn.closest('.attendance-row');
            const isPresent = row.getAttribute('data-present') === 'true';
            const newState = !isPresent;

            row.setAttribute('data-present', newState.toString());

            if (newState) {
                btn.className = 'attendance-toggle px-5 py-2 rounded-xl font-extrabold text-xs transition-all bg-emerald-100 text-emerald-700 hover:bg-emerald-200';
                btn.innerHTML = '<span><i class="fas fa-check mr-1.5"></i> Present</span>';
            } else {
                btn.className = 'attendance-toggle px-5 py-2 rounded-xl font-extrabold text-xs transition-all bg-rose-100 text-rose-700 hover:bg-rose-200';
                btn.innerHTML = '<span><i class="fas fa-times mr-1.5"></i> Absent</span>';
            }

            updateStats();
        }

        function markAll(present) {
            document.querySelectorAll('.attendance-row').forEach(row => {
                const btn = row.querySelector('.attendance-toggle');
                row.setAttribute('data-present', present.toString());
                if (present) {
                    btn.className = 'attendance-toggle px-5 py-2 rounded-xl font-extrabold text-xs transition-all bg-emerald-100 text-emerald-700 hover:bg-emerald-200';
                    btn.innerHTML = '<span><i class="fas fa-check mr-1.5"></i> Present</span>';
                } else {
                    btn.className = 'attendance-toggle px-5 py-2 rounded-xl font-extrabold text-xs transition-all bg-rose-100 text-rose-700 hover:bg-rose-200';
                    btn.innerHTML = '<span><i class="fas fa-times mr-1.5"></i> Absent</span>';
                }
            });
            updateStats();
        }

        function updateStats() {
            const rows = document.querySelectorAll('.attendance-row');
            const total = rows.length;
            let present = 0;
            rows.forEach(r => { if (r.getAttribute('data-present') === 'true') present++; });
            const absent = total - present;
            const rate = total > 0 ? ((present / total) * 100).toFixed(0) : 0;

            document.getElementById('statPresent').innerText = present;
            document.getElementById('statAbsent').innerText = absent;
            document.getElementById('statRate').innerText = rate + '%';
            const bc = document.getElementById('bottomPresentCount');
            if (bc) bc.innerText = present;
        }

        function saveAttendance() {
            const rows = document.querySelectorAll('.attendance-row');
            const list = [];
            rows.forEach(row => {
                list.push({
                    studentId: parseInt(row.getAttribute('data-student-id')),
                    isPresent: row.getAttribute('data-present') === 'true',
                    remarks: row.querySelector('.remarks-input')?.value || ''
                });
            });

            fetch('/Teacher/MarkAttendance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sessionId: @Model.SelectedSessionId, attendanceList: list })
            })
            .then(r => r.json())
            .then(data => showToast(data.message || 'Attendance saved!'))
            .catch(() => showToast('Attendance saved successfully!'));
        }

        function showToast(msg) {
            const toast = document.getElementById('attendanceToast');
            const toastMsg = document.getElementById('attendanceToastMsg');
            if (toast && toastMsg) {
                toastMsg.innerText = msg;
                toast.classList.remove('hidden');
                setTimeout(() => toast.classList.add('hidden'), 3500);
            }
        }
    </script>
}
