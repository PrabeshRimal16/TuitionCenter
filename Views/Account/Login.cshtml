@model TuitionCenter.Models.UserListEdit

@{
    ViewData["Title"] = "Sign In — TuitionCenter";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <!-- Logo -->
        <a class="auth-logo" asp-controller="Home" asp-action="Index">
            <div class="auth-logo-mark">🎓</div>
            <span class="auth-logo-name">TuitionCenter</span>
        </a>

        <!-- Header -->
        <div class="auth-header">
            <h1 class="auth-title">Welcome back</h1>
            <p class="auth-subtitle">Sign in to your account to continue</p>
        </div>

        <!-- Form -->
        <form asp-controller="Account" asp-action="Login" method="post" class="auth-form" id="loginForm">

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <div class="auth-input-wrap">
                    <input asp-for="Email"
                           class="form-control"
                           placeholder="you@example.com"
                           autocomplete="email"
                           id="loginEmail" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PasswordHash">Password</label>
                <div class="auth-input-wrap">
                    <input asp-for="PasswordHash"
                           class="form-control has-toggle"
                           placeholder="Enter your password"
                           type="password"
                           autocomplete="current-password"
                           id="loginPassword" />
                    <button type="button" class="auth-pw-toggle" onclick="togglePw('loginPassword', this)" aria-label="Show password" id="loginPwBtn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </button>
                </div>
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-submit-btn" id="loginSubmitBtn">
                Sign in
            </button>

        </form>

        <hr class="auth-divider" />

        <div class="auth-switch">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register" id="goToRegister">Create one</a>
        </div>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function togglePw(id, btn) {
            const inp = document.getElementById(id);
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            btn.innerHTML = show
                ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
                : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
        }
    </script>
}