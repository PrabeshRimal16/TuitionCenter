@model TuitionCenter.Models.UserListEdit

@{
    ViewData["Title"] = "Sign In — TuitionCenter";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-wrapper">

    <!-- ── LEFT: Branding Panel ── -->
    <div class="auth-brand-panel">
        <!-- Floating shapes -->
        <div class="brand-shape brand-shape-1"></div>
        <div class="brand-shape brand-shape-2"></div>
        <div class="brand-shape brand-shape-3"></div>
        <div class="brand-shape brand-shape-4"></div>

        <!-- Logo -->
        <a class="auth-logo-link" asp-controller="Home" asp-action="Index">
            <div class="auth-logo-icon">🎓</div>
            <span class="auth-logo-text">TuitionCenter</span>
        </a>

        <h2 class="auth-brand-headline">
            Welcome Back to<br />
            Your <span class="gtext">Learning Journey</span>
        </h2>
        <p class="auth-brand-sub">
            Sign in to access your personalized dashboard, courses, and track your academic progress.
        </p>

        <ul class="auth-brand-features">
            <li>
                <span class="auth-feature-icon">📚</span>
                Access all your enrolled courses
            </li>
            <li>
                <span class="auth-feature-icon">📊</span>
                View your progress & attendance
            </li>
            <li>
                <span class="auth-feature-icon">💬</span>
                Connect with your teachers
            </li>
            <li>
                <span class="auth-feature-icon">🏆</span>
                Track your achievements
            </li>
        </ul>
    </div>

    <!-- ── RIGHT: Form Panel ── -->
    <div class="auth-form-panel">
        <div class="auth-form-container">

            <div class="auth-form-header">
                <div class="auth-form-eyebrow">✦ Welcome back</div>
                <h1 class="auth-form-title">Sign In</h1>
                <p class="auth-form-subtitle">Enter your credentials to continue learning</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" class="auth-form" id="loginForm">

                <div asp-validation-summary="ModelOnly" class="validation-summary text-danger mb-3"></div>

                <!-- Email -->
                <div class="form-group">
                    <label asp-for="Email">Email Address</label>
                    <div class="auth-input-wrap">
                        <span class="auth-input-icon">✉</span>
                        <input asp-for="Email"
                               class="form-control"
                               placeholder="you@example.com"
                               autocomplete="email"
                               id="loginEmail" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="form-group">
                    <label asp-for="PasswordHash">Password</label>
                    <div class="auth-input-wrap">
                        <span class="auth-input-icon">🔒</span>
                        <input asp-for="PasswordHash"
                               class="form-control has-toggle"
                               placeholder="Enter your password"
                               type="password"
                               autocomplete="current-password"
                               id="loginPassword" />
                        <button type="button" class="auth-pw-toggle" onclick="togglePassword('loginPassword', this)" aria-label="Show/hide password" id="loginPwToggle">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span asp-validation-for="PasswordHash" class="text-danger"></span>
                </div>

                <!-- Submit -->
                <button type="submit" class="auth-submit-btn" id="loginSubmitBtn">
                    Sign In
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>

            </form>

            <div class="auth-alt-link">
                Don't have an account?
                <a asp-controller="Account" asp-action="Register" id="switchToRegister">Create one free →</a>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            btn.innerHTML = isHidden
                ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>'
                : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
        }
    </script>
}