@model List<TuitionCenter.Models.ViewModels.Admin.TeacherVM>

@{
    ViewData["Title"] = "Manage Teachers";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page">

    <div class="page-header">
        <div>
            <h1>Teachers</h1>
            <p>Manage and monitor all teachers in the tuition center.</p>
        </div>

        <a asp-controller="Admin" asp-action="CreateTeacher" class="btn-primary-custom">
            <i class="bi bi-plus-lg"></i>
            Add Teacher
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Stat Cards Overview -->
    <div class="teacher-stats">

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <span>Total Teachers</span>
                <h3>@Model.Count</h3>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="bi bi-person-check-fill"></i>
            </div>
            <div>
                <span>Active Teachers</span>
                <h3>@Model.Count(t => t.IsActive)</h3>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon red">
                <i class="bi bi-person-x-fill"></i>
            </div>
            <div>
                <span>Inactive Teachers</span>
                <h3>@Model.Count(t => !t.IsActive)</h3>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <span>Assigned Batches</span>
                <h3>@Model.Sum(t => t.AssignedBatchCount)</h3>
            </div>
        </div>

    </div>

    <!-- Content Card & Table -->
    <div class="content-card">

        <div class="content-card-header">
            <div>
                <h3>All Teachers</h3>
                <p>View and manage registered teacher accounts.</p>
            </div>

            <div class="teacher-search">
                <i class="bi bi-search"></i>
                <input type="text" id="teacherSearch" placeholder="Search teachers..." />
            </div>
        </div>

        <div class="table-container">

            <table class="teacher-table" id="teacherTable">
                <thead>
                    <tr>
                        <th>Teacher</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Assigned Batches</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var teacher in Model)
                        {
                            <tr>
                                <td>
                                    <div class="teacher-info">
                                        <div class="teacher-avatar">
                                            @(!string.IsNullOrWhiteSpace(teacher.FullName) ? teacher.FullName.Trim()[0].ToString().ToUpper() : "T")
                                        </div>
                                        <div>
                                            <strong>@teacher.FullName</strong>
                                            <small>ID: #@teacher.UserId</small>
                                        </div>
                                    </div>
                                </td>

                                <td>@teacher.Email</td>

                                <td>@(teacher.Phone ?? "Not provided")</td>

                                <td>
                                    <span class="batch-count">
                                        @teacher.AssignedBatchCount
                                    </span>
                                </td>

                                <td>
                                    @if (teacher.IsActive)
                                    {
                                        <span class="status active">
                                            <span></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status inactive">
                                            <span></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="action-buttons">
                                        <a asp-controller="Admin"
                                           asp-action="TeacherDetails"
                                           asp-route-id="@teacher.UserId"
                                           class="action-btn view"
                                           title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="EditTeacher"
                                           asp-route-id="@teacher.UserId"
                                           class="action-btn edit"
                                           title="Edit Teacher">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-controller="Admin"
                                              asp-action="ToggleTeacherStatus"
                                              asp-route-id="@teacher.UserId"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="action-btn toggle"
                                                    title="@(teacher.IsActive ? "Deactivate Teacher" : "Activate Teacher")">
                                                @if (teacher.IsActive)
                                                {
                                                    <i class="bi bi-person-x"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-person-check"></i>
                                                }
                                            </button>
                                        </form>

                                        <button type="button"
                                                class="action-btn delete"
                                                title="Delete Teacher"
                                                onclick="confirmDelete(@teacher.UserId, '@Html.Raw(teacher.FullName.Replace("'","\\\'"))')">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="empty-state">
                                    <i class="bi bi-people"></i>
                                    <h4>No Teachers Found</h4>
                                    <p>Start by adding your first teacher.</p>
                                    <a asp-controller="Admin" asp-action="CreateTeacher" class="btn-primary-custom">
                                        <i class="bi bi-plus-lg"></i>
                                        Add Teacher
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

    </div>

</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px; border:none; overflow:hidden;">
            <div class="modal-body text-center p-5">
                <div style="width:72px;height:72px;border-radius:50%;background:rgba(239,68,68,.12);display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size:2rem;color:#ef4444;"></i>
                </div>
                <h4 style="font-weight:700;margin-bottom:8px;">Delete Teacher?</h4>
                <p class="text-muted" id="deleteModalBody">This action cannot be undone.</p>
            </div>
            <div class="modal-footer justify-content-center border-0 pb-4 gap-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn rounded-pill px-4" style="background:#ef4444;color:#fff;font-weight:600;">
                        <i class="bi bi-trash3 me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Live search
            const searchInput = document.getElementById("teacherSearch");
            if (searchInput) {
                searchInput.addEventListener("keyup", function () {
                    const searchValue = this.value.toLowerCase();
                    const rows = document.querySelectorAll("#teacherTable tbody tr");
                    rows.forEach(row => {
                        row.style.display = row.innerText.toLowerCase().includes(searchValue) ? "" : "none";
                    });
                });
            }
        });

        function confirmDelete(id, name) {
            document.getElementById('deleteModalBody').textContent =
                'Are you sure you want to permanently delete "' + name + '"? This action cannot be undone.';
            document.getElementById('deleteForm').action = '/Admin/Teachers/Delete/' + id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}