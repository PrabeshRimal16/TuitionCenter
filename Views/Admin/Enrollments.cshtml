@model TuitionCenter.Models.ViewModels.Admin.EnrollmentsListVM

@{
    ViewData["Title"] = "Enrollments";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .enroll-list-page { padding: 4px 0 40px; }
    .enroll-list-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 28px; flex-wrap: wrap; gap: 12px;
    }
    .enroll-list-title { font-size: 24px; font-weight: 900; color: #1e1b4b; margin: 0; }
    .enroll-list-sub { font-size: 14px; color: #64748b; margin: 4px 0 0; }

    .enroll-stats { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
    .enroll-stat-card {
        flex: 1; min-width: 120px;
        background: #fff; border-radius: 16px;
        border: 1px solid #e2e8f0; padding: 18px 22px;
        box-shadow: 0 2px 12px rgba(0,0,0,.04);
    }
    .enroll-stat-num { font-size: 26px; font-weight: 900; color: #1e1b4b; }
    .enroll-stat-label { font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .8px; margin-top: 2px; }
    .enroll-stat-card.pending .enroll-stat-num { color: #d97706; }
    .enroll-stat-card.approved .enroll-stat-num { color: #16a34a; }
    .enroll-stat-card.rejected .enroll-stat-num { color: #dc2626; }

    .filter-tabs { display: flex; gap: 8px; margin-bottom: 22px; flex-wrap: wrap; }
    .filter-tab {
        padding: 8px 20px; border-radius: 999px; font-size: 13px; font-weight: 700;
        text-decoration: none; border: 2px solid #e2e8f0; color: #475569; background: #fff;
        transition: all .16s ease;
    }
    .filter-tab:hover { border-color: #a5b4fc; color: #4f46e5; }
    .filter-tab.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }

    .enroll-table-wrap {
        background: #fff; border-radius: 20px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
        overflow: hidden;
    }
    .enroll-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .enroll-table thead tr { background: #f8fafc; border-bottom: 2px solid #e2e8f0; }
    .enroll-table th {
        padding: 14px 18px; text-align: left;
        font-size: 11px; font-weight: 800; color: #64748b;
        text-transform: uppercase; letter-spacing: .8px;
    }
    .enroll-table td { padding: 14px 18px; border-bottom: 1px solid #f1f5f9; color: #1e293b; vertical-align: middle; }
    .enroll-table tr:last-child td { border-bottom: none; }
    .enroll-table tr:hover td { background: #f8fafc; }

    .e-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 700;
    }
    .e-badge.pending  { background: #fef9c3; color: #92400e; }
    .e-badge.approved { background: #dcfce7; color: #15803d; }
    .e-badge.rejected { background: #fee2e2; color: #b91c1c; }
    .e-badge.dash     { background: #f1f5f9; color: #94a3b8; }

    .e-action-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 7px 14px; border-radius: 10px; font-size: 12px; font-weight: 700;
        text-decoration: none; transition: all .15s ease; border: 1.5px solid transparent;
    }
    .e-action-btn.view  { background: #eff6ff; color: #2563eb; border-color: #bfdbfe; }
    .e-action-btn.view:hover { background: #2563eb; color: #fff; }

    .empty-state { text-align: center; padding: 60px 20px; }
    .empty-state i { font-size: 48px; color: #cbd5e1; margin-bottom: 16px; display: block; }
    .empty-state h4 { font-size: 17px; font-weight: 700; color: #334155; margin: 0 0 6px; }
    .empty-state p { font-size: 13px; color: #64748b; margin: 0; }

    .alert-banner {
        border-radius: 12px; padding: 12px 18px; margin-bottom: 20px;
        display: flex; align-items: center; gap: 10px; font-weight: 600; font-size: 14px;
    }
    .alert-banner.success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
    .alert-banner.error   { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
</style>

<div class="enroll-list-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-banner success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-banner error"><i class="bi bi-x-circle-fill"></i> @TempData["ErrorMessage"]</div>
    }

    <div class="enroll-list-header">
        <div>
            <h1 class="enroll-list-title">Enrollments</h1>
            <p class="enroll-list-sub">Review and manage student enrollment applications</p>
        </div>
    </div>

    <!-- Stats -->
    <div class="enroll-stats">
        <div class="enroll-stat-card">
            <div class="enroll-stat-num">@Model.TotalCount</div>
            <div class="enroll-stat-label">Total</div>
        </div>
        <div class="enroll-stat-card pending">
            <div class="enroll-stat-num">@Model.PendingCount</div>
            <div class="enroll-stat-label">Pending</div>
        </div>
        <div class="enroll-stat-card approved">
            <div class="enroll-stat-num">@Model.ApprovedCount</div>
            <div class="enroll-stat-label">Approved</div>
        </div>
        <div class="enroll-stat-card rejected">
            <div class="enroll-stat-num">@Model.RejectedCount</div>
            <div class="enroll-stat-label">Rejected</div>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
        @foreach (var tab in new[] { "All", "Pending", "Approved", "Rejected" })
        {
            <a href="?filter=@tab" class="filter-tab @(Model.ActiveFilter == tab ? "active" : "")">
                @tab
                @if (tab == "Pending" && Model.PendingCount > 0)
                {
                    <span style="background:#fbbf24;color:#1c1c1c;border-radius:999px;padding:1px 8px;font-size:10px;margin-left:4px;">@Model.PendingCount</span>
                }
            </a>
        }
    </div>

    <!-- Table -->
    <div class="enroll-table-wrap">
        @if (!Model.Enrollments.Any())
        {
            <div class="empty-state">
                <i class="bi bi-folder-x"></i>
                <h4>No enrollments found</h4>
                <p>There are no @(Model.ActiveFilter == "All" ? "" : Model.ActiveFilter.ToLower()) enrollment applications yet.</p>
            </div>
        }
        else
        {
            <table class="enroll-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Class / Subjects</th>
                        <th>Plan</th>
                        <th>Amount</th>
                        <th>Enrollment</th>
                        <th>Payment</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Enrollments)
                    {
                        <tr>
                            <td>
                                <div style="font-weight:700;color:#1e1b4b;">@e.StudentName</div>
                                <div style="font-size:12px;color:#94a3b8;">@e.StudentEmail</div>
                            </td>
                            <td>
                                <div style="font-weight:700;">@e.ClassName</div>
                                <div style="font-size:12px;color:#64748b;">@e.SubjectsSummary</div>
                            </td>
                            <td>@e.CourseType</td>
                            <td style="font-weight:800;color:#4f46e5;">Rs @e.Amount.ToString("N0")</td>
                            <td>
                                @{
                                    var eStatus = (e.EnrollmentStatus ?? "").ToLower();
                                    var eBadge = eStatus switch { "approved" => "approved", "rejected" => "rejected", "pending" => "pending", _ => "dash" };
                                    var eIcon  = eStatus switch { "approved" => "bi-check-circle-fill", "rejected" => "bi-x-circle-fill", "pending" => "bi-clock-fill", _ => "bi-dash" };
                                }
                                <span class="e-badge @eBadge"><i class="bi @eIcon"></i> @e.EnrollmentStatus</span>
                            </td>
                            <td>
                                @{
                                    var pStatus = (e.PaymentStatus ?? "").ToLower();
                                    var pBadge = pStatus switch { "approved" => "approved", "rejected" => "rejected", "pending" => "pending", _ => "dash" };
                                }
                                <span class="e-badge @pBadge">@e.PaymentStatus</span>
                            </td>
                            <td style="font-size:12px;color:#64748b;">@e.EnrollmentDate?.ToString("MMM d, yyyy")</td>
                            <td>
                                <a asp-action="EnrollmentDetails" asp-route-id="@e.EnrollmentId" class="e-action-btn view">
                                    <i class="bi bi-eye"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
