@model TuitionCenter.Models.ViewModels.Admin.StudentEnrollmentVM

@{
    ViewData["Title"] = "Enrollment Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var isPending = Model.EnrollmentStatus == "Pending";
}

<style>
    .ed-page { max-width: 900px; }
    .ed-back { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #4f46e5; text-decoration: none; margin-bottom: 20px; }
    .ed-back:hover { color: #3730a3; }

    .ed-header {
        display: flex; justify-content: space-between; align-items: flex-start;
        margin-bottom: 28px; flex-wrap: wrap; gap: 12px;
    }
    .ed-title { font-size: 24px; font-weight: 900; color: #1e1b4b; margin: 0 0 4px; }
    .ed-num { font-size: 13px; color: #64748b; }
    .e-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 6px 16px; border-radius: 999px; font-size: 13px; font-weight: 700;
    }
    .e-badge.pending  { background: #fef9c3; color: #92400e; }
    .e-badge.approved { background: #dcfce7; color: #15803d; }
    .e-badge.rejected { background: #fee2e2; color: #b91c1c; }

    .ed-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    @@media (max-width: 640px) { .ed-grid { grid-template-columns: 1fr; } }

    .ed-card {
        background: #fff; border-radius: 18px; border: 1px solid #e2e8f0;
        padding: 24px; box-shadow: 0 3px 16px rgba(0,0,0,.04);
    }
    .ed-card-title {
        font-size: 11px; font-weight: 800; color: #4f46e5; text-transform: uppercase;
        letter-spacing: 1px; margin: 0 0 18px; display: flex; align-items: center; gap: 8px;
    }
    .ed-card-title i { font-size: 14px; }
    .ed-row { display: flex; justify-content: space-between; padding: 9px 0; border-bottom: 1px solid #f1f5f9; font-size: 14px; }
    .ed-row:last-child { border-bottom: none; }
    .ed-row-label { color: #64748b; font-weight: 600; }
    .ed-row-value { color: #1e1b4b; font-weight: 700; text-align: right; max-width: 60%; }

    .ed-amount-badge {
        background: linear-gradient(135deg, #f0f0ff, #ede9fe);
        border: 2px solid #c7d2fe; border-radius: 12px;
        padding: 14px 20px; text-align: center; margin-top: 12px;
    }
    .ed-amount-badge .label { font-size: 11px; color: #6d28d9; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; }
    .ed-amount-badge .value { font-size: 28px; font-weight: 900; color: #4f46e5; }

    .ed-screenshot {
        margin-top: 16px; border-radius: 12px; overflow: hidden;
        border: 2px solid #e2e8f0;
    }
    .ed-screenshot img { width: 100%; display: block; }
    .ed-screenshot-link {
        display: block; padding: 12px 16px; text-align: center;
        background: #f8fafc; font-size: 13px; font-weight: 700; color: #4f46e5;
        text-decoration: none;
    }
    .ed-screenshot-link:hover { background: #f0f0ff; }

    .ed-action-card {
        background: #fff; border-radius: 18px; border: 1px solid #e2e8f0;
        padding: 28px; box-shadow: 0 3px 16px rgba(0,0,0,.04);
        margin-top: 24px;
    }
    .ed-action-title { font-size: 16px; font-weight: 800; color: #1e1b4b; margin: 0 0 20px; }

    .ed-action-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .btn-approve {
        flex: 1; padding: 14px; border: none; border-radius: 14px;
        background: linear-gradient(135deg, #16a34a, #15803d);
        color: #fff; font-size: 15px; font-weight: 800; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        box-shadow: 0 6px 20px rgba(22,163,74,.3); transition: all .18s ease;
    }
    .btn-approve:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(22,163,74,.4); }
    .btn-reject {
        flex: 1; padding: 14px; border: 2px solid #fecaca; border-radius: 14px;
        background: #fff; color: #dc2626; font-size: 15px; font-weight: 800; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        transition: all .18s ease;
    }
    .btn-reject:hover { background: #fef2f2; border-color: #dc2626; }

    /* Reject modal */
    .reject-modal-bg {
        display: none; position: fixed; inset: 0;
        background: rgba(0,0,0,.5); z-index: 1000;
        align-items: center; justify-content: center;
    }
    .reject-modal-bg.open { display: flex; }
    .reject-modal {
        background: #fff; border-radius: 20px; padding: 32px;
        max-width: 460px; width: 90%; box-shadow: 0 20px 60px rgba(0,0,0,.2);
        animation: slideUp .25s cubic-bezier(.175,.885,.32,1.275);
    }
    @@keyframes slideUp {
        from { transform: translateY(40px); opacity: 0; }
        to   { transform: translateY(0); opacity: 1; }
    }
    .reject-modal h3 { font-size: 18px; font-weight: 800; color: #1e1b4b; margin: 0 0 8px; }
    .reject-modal p { font-size: 14px; color: #64748b; margin: 0 0 20px; }
    .reject-modal textarea {
        width: 100%; padding: 12px 14px; border: 2px solid #e2e8f0; border-radius: 12px;
        font-size: 14px; color: #1e293b; resize: vertical; min-height: 100px;
        font-family: inherit; outline: none; box-sizing: border-box;
    }
    .reject-modal textarea:focus { border-color: #dc2626; }
    .reject-modal-actions { display: flex; gap: 10px; margin-top: 16px; }
    .btn-modal-cancel {
        flex: 1; padding: 12px; border: 2px solid #e2e8f0; border-radius: 12px;
        background: #fff; color: #475569; font-weight: 700; cursor: pointer; font-size: 14px;
    }
    .btn-modal-reject {
        flex: 1; padding: 12px; border: none; border-radius: 12px;
        background: #dc2626; color: #fff; font-weight: 700; cursor: pointer; font-size: 14px;
    }
    .btn-modal-reject:hover { background: #b91c1c; }

    .rejected-banner {
        background: #fef2f2; border: 1px solid #fecaca; border-radius: 12px;
        padding: 16px 20px; display: flex; gap: 12px; align-items: flex-start;
    }
    .approved-banner {
        background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 12px;
        padding: 16px 20px; display: flex; gap: 12px; align-items: flex-start;
    }
</style>

<div class="ed-page">

    <a asp-action="Enrollments" class="ed-back">
        <i class="bi bi-arrow-left"></i> Back to Enrollments
    </a>

    <div class="ed-header">
        <div>
            <h1 class="ed-title">Enrollment Review</h1>
            <p class="ed-num">Application #@Model.EnrollmentNumber</p>
        </div>
        @{
            var statusClass = (Model.EnrollmentStatus ?? "").ToLower();
            var statusIcon = statusClass switch { "approved" => "bi-check-circle-fill", "rejected" => "bi-x-circle-fill", _ => "bi-clock-fill" };
        }
        <span class="e-badge @statusClass">
            <i class="bi @statusIcon"></i> @Model.EnrollmentStatus
        </span>
    </div>

    <div class="ed-grid">

        <!-- Student Info -->
        <div class="ed-card">
            <div class="ed-card-title"><i class="bi bi-person-fill"></i> Student Information</div>
            <div class="ed-row">
                <span class="ed-row-label">Full Name</span>
                <span class="ed-row-value">@Model.StudentName</span>
            </div>
            <div class="ed-row">
                <span class="ed-row-label">Email</span>
                <span class="ed-row-value" style="font-size:13px;">@Model.StudentEmail</span>
            </div>
            <div class="ed-row">
                <span class="ed-row-label">Applied On</span>
                <span class="ed-row-value">@Model.EnrollmentDate?.ToString("MMM d, yyyy 'at' h:mm tt")</span>
            </div>
        </div>

        <!-- Course Info -->
        <div class="ed-card">
            <div class="ed-card-title"><i class="bi bi-mortarboard-fill"></i> Course Details</div>
            <div class="ed-row">
                <span class="ed-row-label">Class</span>
                <span class="ed-row-value">@Model.ClassName</span>
            </div>
            <div class="ed-row">
                <span class="ed-row-label">Subjects</span>
                <span class="ed-row-value">@Model.SubjectsSummary</span>
            </div>
            <div class="ed-row">
                <span class="ed-row-label">Plan</span>
                <span class="ed-row-value">@Model.CourseType</span>
            </div>
            <div class="ed-row">
                <span class="ed-row-label">Time Slot</span>
                <span class="ed-row-value">@Model.TimeSlotLabel</span>
            </div>
            <div class="ed-amount-badge">
                <div class="label">Total Fee</div>
                <div class="value">Rs @Model.Amount.ToString("N0")</div>
            </div>
        </div>

        <!-- Payment Info -->
        <div class="ed-card">
            <div class="ed-card-title"><i class="bi bi-credit-card-fill"></i> Payment Details</div>
            <div class="ed-row">
                <span class="ed-row-label">Method</span>
                <span class="ed-row-value">@(Model.PaymentMethod ?? "–")</span>
            </div>
            <div class="ed-row">
                <span class="ed-row-label">Transaction ID</span>
                <span class="ed-row-value">@(Model.TransactionId ?? "–")</span>
            </div>
            <div class="ed-row">
                <span class="ed-row-label">Payment Status</span>
                <span class="ed-row-value">@Model.PaymentStatus</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ScreenshotPath))
            {
                <div class="ed-screenshot" style="margin-top:16px;">
                    @if (Model.ScreenshotPath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                    {
                        <a href="@Model.ScreenshotPath" target="_blank" class="ed-screenshot-link">
                            <i class="bi bi-file-earmark-pdf me-2"></i> View PDF Receipt
                        </a>
                    }
                    else
                    {
                        <img src="@Model.ScreenshotPath" alt="Payment Screenshot" style="max-height:200px;object-fit:cover;" />
                        <a href="@Model.ScreenshotPath" target="_blank" class="ed-screenshot-link">
                            <i class="bi bi-zoom-in me-1"></i> View Full Screenshot
                        </a>
                    }
                </div>
            }
            else
            {
                <div style="margin-top:16px;padding:14px;background:#f8fafc;border-radius:10px;text-align:center;color:#94a3b8;font-size:13px;">
                    <i class="bi bi-image me-1"></i> No screenshot uploaded
                </div>
            }
        </div>

        <!-- Status / History -->
        <div class="ed-card">
            <div class="ed-card-title"><i class="bi bi-activity"></i> Enrollment Status</div>
            @if (Model.EnrollmentStatus == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
            {
                <div class="rejected-banner">
                    <i class="bi bi-x-circle-fill" style="color:#dc2626;flex-shrink:0;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;color:#b91c1c;margin-bottom:4px;">Rejection Reason</div>
                        <div style="font-size:13px;color:#7f1d1d;">@Model.RejectionReason</div>
                    </div>
                </div>
            }
            else if (Model.EnrollmentStatus == "Approved")
            {
                <div class="approved-banner">
                    <i class="bi bi-check-circle-fill" style="color:#16a34a;flex-shrink:0;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;color:#15803d;margin-bottom:4px;">Enrollment Approved</div>
                        <div style="font-size:13px;color:#14532d;">Student has been enrolled and can attend classes.</div>
                    </div>
                </div>
            }
            else
            {
                <div style="padding:18px;background:#fef9c3;border-radius:12px;text-align:center;color:#92400e;">
                    <i class="bi bi-hourglass-split" style="font-size:28px;display:block;margin-bottom:8px;"></i>
                    <div style="font-weight:700;font-size:14px;">Awaiting Admin Review</div>
                    <div style="font-size:12px;margin-top:4px;">This enrollment application is pending approval.</div>
                </div>
            }
        </div>

    </div>

    <!-- Action Card (only for pending) -->
    @if (isPending)
    {
        <div class="ed-action-card">
            <div class="ed-action-title">Take Action on This Enrollment</div>
            <div class="ed-action-row">
                <!-- Approve Form -->
                <form asp-action="ApproveEnrollment" asp-route-id="@Model.EnrollmentId" method="post" style="flex:1;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-approve" onclick="return confirm('Approve this enrollment for @Model.StudentName?')">
                        <i class="bi bi-check-lg"></i> Approve Enrollment
                    </button>
                </form>
                <!-- Reject Button (opens modal) -->
                <button type="button" class="btn-reject" onclick="openRejectModal()" style="flex:1;">
                    <i class="bi bi-x-lg"></i> Reject Enrollment
                </button>
            </div>
        </div>
    }

</div>

<!-- Reject Modal -->
<div class="reject-modal-bg" id="rejectModalBg">
    <div class="reject-modal">
        <h3>Reject Enrollment</h3>
        <p>Provide a reason for rejection. This will be visible to the student.</p>
        <form asp-action="RejectEnrollment" asp-route-id="@Model.EnrollmentId" method="post">
            @Html.AntiForgeryToken()
            <textarea name="rejectionReason" placeholder="e.g. Payment not received, Incorrect details submitted..." required></textarea>
            <div class="reject-modal-actions">
                <button type="button" class="btn-modal-cancel" onclick="closeRejectModal()">Cancel</button>
                <button type="submit" class="btn-modal-reject"><i class="bi bi-x-circle me-1"></i> Confirm Rejection</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openRejectModal() {
        document.getElementById('rejectModalBg').classList.add('open');
    }
    function closeRejectModal() {
        document.getElementById('rejectModalBg').classList.remove('open');
    }
    document.getElementById('rejectModalBg').addEventListener('click', function(e) {
        if (e.target === this) closeRejectModal();
    });
</script>
