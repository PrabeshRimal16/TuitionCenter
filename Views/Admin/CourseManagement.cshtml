<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form id="deleteConfirmForm" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="deleteModalTitle">
                        <i class="bi bi-exclamation-triangle-fill"></i> Delete Confirmation
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-secondary mb-0" id="deleteModalMessage">Are you sure you want to proceed with this deletion?</p>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3 px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-3 px-4">Confirm Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- 1. Dynamic Search & Filter on Tables ---
            const searchInput = document.getElementById('tableSearchInput');
            if (searchInput) {
                searchInput.addEventListener('keyup', function () {
                    const filter = this.value.toLowerCase();
                    const activePane = document.querySelector('.tab-pane.active');
                    if (activePane) {
                        const rows = activePane.querySelectorAll('tbody tr');
                        rows.forEach(row => {
                            const text = row.textContent.toLowerCase();
                            row.style.display = text.includes(filter) ? '' : 'none';
                        });
                    }
                });
            }

            // Reset search when changing tabs
            const tabBtns = document.querySelectorAll('#mgmtTabs button');
            tabBtns.forEach(btn => {
                btn.addEventListener('shown.bs.tab', function () {
                    if (searchInput) {
                        searchInput.value = '';
                        const rows = document.querySelectorAll('tbody tr');
                        rows.forEach(r => r.style.display = '');
                    }
                });
            });

            // --- 2. Delete Confirmation Modal Setup ---
            const deleteButtons = document.querySelectorAll('.delete-btn');
            const deleteConfirmModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            const deleteForm = document.getElementById('deleteConfirmForm');
            const deleteTitle = document.getElementById('deleteModalTitle');
            const deleteMessage = document.getElementById('deleteModalMessage');

            deleteButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const action = this.getAttribute('data-action');
                    const title = this.getAttribute('data-title') || 'Confirm Deletion';
                    const message = this.getAttribute('data-message') || 'Are you sure you want to delete this item?';

                    deleteForm.setAttribute('action', action);
                    deleteTitle.innerHTML = `<i class="bi bi-exclamation-triangle-fill"></i> ${title}`;
                    deleteMessage.textContent = message;
                    deleteConfirmModal.show();
                });
            });

            // --- 3. Dynamic Subject Cascading Dropdown Helper ---
            function loadSubjectsForClass(classId, subjectSelectEl, callback) {
                if (!classId) {
                    subjectSelectEl.innerHTML = '<option value="">-- Select Class First --</option>';
                    subjectSelectEl.disabled = true;
                    if (callback) callback();
                    return;
                }

                fetch(`/Admin/GetSubjectsByClass/${classId}`)
                    .then(res => res.json())
                    .then(data => {
                        subjectSelectEl.innerHTML = '<option value="">-- Select Subject --</option>';
                        data.forEach(sub => {
                            const opt = document.createElement('option');
                            opt.value = sub.subjectId;
                            opt.textContent = sub.subjectName;
                            subjectSelectEl.appendChild(opt);
                        });
                        subjectSelectEl.disabled = false;
                        if (callback) callback();
                    })
                    .catch(err => {
                        console.error('Error fetching subjects:', err);
                        subjectSelectEl.disabled = true;
                    });
            }

            // Create Batch Class -> Subject
            const createClassSel = document.getElementById('createBatchClassSelect');
            const createSubSel = document.getElementById('createBatchSubjectSelect');
            if (createClassSel && createSubSel) {
                createClassSel.addEventListener('change', function () {
                    loadSubjectsForClass(this.value, createSubSel);
                });
            }

            // Assign Teacher Class -> Subject -> Batch
            const assignClassSel = document.getElementById('assignClassSelect');
            const assignSubSel = document.getElementById('assignSubjectSelect');
            const assignBatchSel = document.getElementById('assignBatchSelect');

            if (assignClassSel && assignSubSel && assignBatchSel) {
                assignClassSel.addEventListener('change', function () {
                    assignBatchSel.innerHTML = '<option value="">-- Select Subject First --</option>';
                    assignBatchSel.disabled = true;
                    loadSubjectsForClass(this.value, assignSubSel);
                });

                assignSubSel.addEventListener('change', function () {
                    const classId = assignClassSel.value;
                    const subjectId = this.value;

                    if (!classId || !subjectId) {
                        assignBatchSel.innerHTML = '<option value="">-- Select Subject First --</option>';
                        assignBatchSel.disabled = true;
                        return;
                    }

                    fetch(`/Admin/GetBatchesByClassAndSubject/${classId}/${subjectId}`)
                        .then(res => res.json())
                        .then(data => {
                            assignBatchSel.innerHTML = '<option value="">-- Select Batch --</option>';
                            if (data.length === 0) {
                                assignBatchSel.innerHTML = '<option value="">No batches available for this subject</option>';
                            } else {
                                data.forEach(b => {
                                    const opt = document.createElement('option');
                                    opt.value = b.batchId;
                                    opt.textContent = `${b.batchName} (${b.teacherName})`;
                                    assignBatchSel.appendChild(opt);
                                });
                            }
                            assignBatchSel.disabled = false;
                        });
                });
            }

            // --- 4. Edit Course Type Modal Trigger ---
            const editCtBtns = document.querySelectorAll('.edit-ct-btn');
            const editCtModal = new bootstrap.Modal(document.getElementById('editCourseTypeModal'));
            editCtBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('editCourseTypeId').value = this.getAttribute('data-id');
                    document.getElementById('editCourseTypeName').value = this.getAttribute('data-name');
                    editCtModal.show();
                });
            });

            // --- 5. Edit Time Slot Modal Trigger ---
            const editTsBtns = document.querySelectorAll('.edit-ts-btn');
            const editTsModal = new bootstrap.Modal(document.getElementById('editTimeSlotModal'));
            editTsBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    document.getElementById('editTimeSlotId').value = this.getAttribute('data-id');
                    document.getElementById('editStartTime').value = this.getAttribute('data-start');
                    document.getElementById('editEndTime').value = this.getAttribute('data-end');
                    document.getElementById('editDays').value = this.getAttribute('data-days');
                    editTsModal.show();
                });
            });

            // --- 6. Edit Batch Modal Trigger ---
            const editBatchBtns = document.querySelectorAll('.edit-batch-btn');
            const editBatchModal = new bootstrap.Modal(document.getElementById('editBatchModal'));
            editBatchBtns.forEach(btn => {
                btn.addEventListener('click', function () {
                    const batchId = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');
                    const classId = this.getAttribute('data-classid');
                    const subjectId = this.getAttribute('data-subjectid');
                    const ctId = this.getAttribute('data-coursetypeid');
                    const tsId = this.getAttribute('data-timeslotid');
                    const cap = this.getAttribute('data-capacity');
                    const active = this.getAttribute('data-isactive');
                    const teacherId = this.getAttribute('data-teacherid');

                    document.getElementById('editBatchId').value = batchId;
                    document.getElementById('editBatchName').value = name;
                    document.getElementById('editBatchClassSelect').value = classId;
                    document.getElementById('editBatchCourseTypeSelect').value = ctId;
                    document.getElementById('editBatchTimeSlotSelect').value = tsId;
                    document.getElementById('editBatchCapacity').value = cap;
                    document.getElementById('editBatchStatusSelect').value = active;
                    document.getElementById('editBatchTeacherSelect').value = teacherId || "0";

                    const editSubSel = document.getElementById('editBatchSubjectSelect');
                    loadSubjectsForClass(classId, editSubSel, function () {
                        editSubSel.value = subjectId;
                    });

                    editBatchModal.show();
                });
            });

            const editBatchClassSel = document.getElementById('editBatchClassSelect');
            if (editBatchClassSel) {
                editBatchClassSel.addEventListener('change', function () {
                    loadSubjectsForClass(this.value, document.getElementById('editBatchSubjectSelect'));
                });
            }

        });
    </script>
}
