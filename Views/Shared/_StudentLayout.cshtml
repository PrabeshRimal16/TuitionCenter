<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/student.css" asp-append-version="true" />

</head>

<body>

    <div class="layout">

        <aside class="sidebar">

            <div class="logo">

                <h2>

                    Study <span>Point</span>

                </h2>

            </div>

        <ul class="menu">

            <li class="active">
                <a asp-controller="Student" asp-action="Dashboard">
                    <i class="bi bi-grid"></i>
                    Dashboard
                </a>
            </li>

            <li>
                <a asp-controller="Student" asp-action="Courses">
                    <i class="bi bi-globe"></i>
                    Browse Courses
                </a>
            </li>

            <li>
                <a asp-controller="Student" asp-action="Schedule">
                    <i class="bi bi-clock-history"></i>
                    My Schedule
                </a>
            </li>

            <li>
                <a asp-controller="Student" asp-action="Assignments">
                    <i class="bi bi-journal-bookmark"></i>
                    Assignments
                </a>
            </li>

            <li>
                <a asp-controller="Student" asp-action="Attendance">
                    <i class="bi bi-calendar-check"></i>
                    Attendance
                </a>
            </li>

            <li>
                <a asp-controller="Student" asp-action="Payments">
                    <i class="bi bi-credit-card"></i>
                    Payments
                </a>
            </li>

            <li>
                <a asp-controller="Student" asp-action="Profile">
                    <i class="bi bi-person"></i>
                    Profile
                </a>
            </li>

        </ul>

            <button class="back-btn">

    <!-- ================= Main ================= -->

                Back

            </button>

        </aside>

        <div class="right-panel">

            <header class="topbar">

                <div class="brand">

                    Study Point

                </div>

                <div class="icons">

                    <i class="bi bi-question-circle"></i>

                    <i class="bi bi-person-circle"></i>

                </div>

            </header>

            <main>

                @RenderBody()

            </main>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>