@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TuitionCenter — Expert tutoring for students. Connect with qualified teachers, track your progress, and achieve your academic goals." />
    <title>@ViewData["Title"] - TuitionCenter</title>
    <!-- Inter Font (local) -->
    <link rel="stylesheet" href="~/lib/google-fonts/inter/inter.css" />
    <!-- Bootstrap (local) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if ((string?)ViewData["BodyClass"] == "landing-page")
    {
        <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    }
    @if ((string?)ViewData["BodyClass"] == "auth-page")
    {
        <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(ViewData["BodyClass"] ?? "")">

    @{
        var bodyClass = (string?)ViewData["BodyClass"] ?? "";
        var isAuthPage = bodyClass == "auth-page";
        var isLandingPage = bodyClass == "landing-page";
    }

    @if (!isAuthPage)
    {
        <!-- Glassmorphism Navbar -->
        <nav class="navbar navbar-expand-md site-navbar" id="siteNavbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="navbar-brand-text" style="display:inline-flex;align-items:center;gap:8px;">
                        <span style="width:32px;height:32px;background:#4f46e5;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;font-size:0.85rem;flex-shrink:0;">🎓</span>
                        TuitionCenter
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-item" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                    </ul>

@using System.Security.Claims
@inject TuitionCenter.Models.TuitionCenterDbContext DbContext

                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var userIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                            int.TryParse(userIdClaim, out int loggedInUserId);
                            var loggedInUser = loggedInUserId > 0 ? DbContext.Users.FirstOrDefault(u => u.UserId == loggedInUserId) : null;
                            var displayName = loggedInUser?.FullName ?? User.Identity?.Name ?? "User";
                            var userRole = loggedInUser?.Role ?? User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                            var profileImg = loggedInUser?.ProfilePictureUrl;
                            var nameParts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var initial = nameParts.Length > 1 ? $"{nameParts[0][0]}{nameParts[1][0]}".ToUpper() : (nameParts.Length == 1 ? nameParts[0][0].ToString().ToUpper() : "U");

                            var dashController = userRole switch
                            {
                                "Admin" => "Admin",
                                "Teacher" => "Teacher",
                                "Student" => "Student",
                                _ => "Home"
                            };

                            <li class="nav-item me-2">
                                <a asp-controller="@dashController" asp-action="Dashboard" class="d-flex align-items-center gap-2 text-decoration-none fw-semibold text-dark">
                                    @if (!string.IsNullOrEmpty(profileImg))
                                    {
                                        <img src="@profileImg" alt="@displayName" style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:1px solid #2563eb;" />
                                    }
                                    else
                                    {
                                        <span style="width:32px;height:32px;border-radius:50%;background:#2563eb;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;">
                                            @initial
                                        </span>
                                    }
                                    <span>@displayName</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-nav-logout">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn-nav-login" asp-controller="Account" asp-action="Login" id="navLoginBtn">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-nav-register" asp-controller="Account" asp-action="Register" id="navRegisterBtn">Get Started</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    }

    @if (isAuthPage || isLandingPage)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <footer class="border-top footer text-muted mt-5">
            <div class="container py-3">
                &copy; @DateTime.Now.Year - TuitionCenter
            </div>
        </footer>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>