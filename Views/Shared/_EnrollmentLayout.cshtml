@{
    var showSidebar = ViewData["ShowSidebar"] as bool? ?? true;
    var activeStep = ViewData["ActiveStep"] as string ?? "Class";
    string StepClass(string name) => name == activeStep ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Study Point</title>
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/enrollment.css" asp-append-version="true" />
</head>
<body>
    <div class="enroll-page">

        @if (showSidebar)
        {
            <aside class="enroll-sidebar">
                <h2>Enrollment Progress</h2>
                <ul class="enroll-steps">
                    <li class="@StepClass("Class")"><a asp-controller="Student" asp-action="EnrollClass"><i class="bi bi-mortarboard"></i> Class</a></li>
                    <li class="@StepClass("Subject")"><a asp-controller="Student" asp-action="Subject"><i class="bi bi-grid"></i> Subject</a></li>
                    <li class="@StepClass("Intake")"><a asp-controller="Student" asp-action="Intake"><i class="bi bi-calendar3"></i> Intake</a></li>
                    <li class="@StepClass("Pricing")"><a asp-controller="Student" asp-action="Pricing"><i class="bi bi-credit-card"></i> Pricing</a></li>
                    <li class="@StepClass("Payments")"><a asp-controller="Student" asp-action="Payments"><i class="bi bi-cash-coin"></i> Payments</a></li>
                </ul>
                <a asp-controller="Student" asp-action="Dashboard" class="enroll-back"><i class="bi bi-arrow-left"></i> Back to Dashboard</a>
            </aside>
        }

        <div class="enroll-main @(showSidebar ? "" : "enroll-main-centered")">

            @if (showSidebar)
            {
                <div class="enroll-topbar" style="border-bottom: 1px solid #e2e8f0;">
                    <a href="/Student/Dashboard" class="logo" style="text-decoration:none; color:#2563eb; font-weight:800; font-size:20px;">
                        Study<span style="color:#0f172a;">Point</span>
                    </a>
                    <div class="right-icons" style="display:flex; align-items:center; gap:16px;">
                        <a href="/Student/Profile" title="Profile Settings" style="color:#475569; font-size:18px; text-decoration:none;">
                            <i class="bi bi-person-circle"></i>
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="enroll-intro-header">
                    <h1 class="enroll-intro-title">Study Point Enrollment</h1>
                    <p class="enroll-intro-subtitle">Step-by-step path to your academic success</p>
                    <hr class="enroll-intro-divider" />
                </div>
            }

            <div class="enroll-content">
                @RenderBody()
            </div>

            <div class="enroll-footer-bar @(showSidebar ? "" : "enroll-footer-bar-right")">
                @if (showSidebar)
                {
                    <span></span>
                    @if (IsSectionDefined("FooterActions"))
                    {
                        @RenderSection("FooterActions", required: false)
                    }
                    else if (ViewData["NextUrl"] != null)
                    {
                        <a class="btn-next" href="@ViewData["NextUrl"]">Next <i class="bi bi-arrow-right"></i></a>
                    }
                }
                else
                {
                    <a asp-controller="Student" asp-action="Dashboard" class="enroll-back"><i class="bi bi-arrow-left"></i> Back</a>
                }
            </div>
        </div>

    </div>
</body>
</html>