@model TuitionCenter.Models.SubjectPickerViewModel

@{
    ViewData["Title"] = "Select Subjects";
    Layout = "_EnrollmentLayout";
    ViewData["ActiveStep"] = "Subject";
}

@if (TempData["EnrollError"] != null)
{
    <div class="enroll-alert" style="background: #fef2f2; border: 1px solid #fecaca; color: #dc2626; padding: 12px 16px; border-radius: 12px; font-weight: 600; margin-bottom: 20px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["EnrollError"]
    </div>
}

<div style="margin-bottom: 24px; display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
    <div>
        <span style="font-size: 11px; font-weight: 800; color: #2563eb; letter-spacing: 1.2px; text-transform: uppercase;">Step 1 of 4 &bull; @Model.ClassName</span>
        <h2 style="font-size: 24px; font-weight: 800; color: #0f172a; margin: 4px 0 4px;">Choose Subjects for @Model.ClassName</h2>
        <p style="font-size: 14px; color: #64748b; margin: 0;">Select one or more tuition subjects you wish to enroll in for this term.</p>
    </div>
    <a asp-action="Subject" asp-route-classId="0" style="font-size: 13px; font-weight: 700; color: #2563eb; text-decoration: none; background: #eff6ff; padding: 8px 14px; border-radius: 10px;">
        <i class="bi bi-arrow-left-right me-1"></i> Change Class
    </a>
</div>

<form asp-action="Subject" method="post" id="subjectForm">
    <input type="hidden" name="classId" value="@Model.ClassId" />

    @if (!Model.Subjects.Any())
    {
        <div style="text-align: center; padding: 48px 20px; background: #fff; border-radius: 16px; border: 1px dashed #cbd5e1;">
            <i class="bi bi-journal-x" style="font-size: 40px; color: #94a3b8;"></i>
            <h4 style="font-size: 16px; font-weight: 700; color: #334155; margin: 12px 0 4px;">No subjects available yet</h4>
            <p style="font-size: 13px; color: #64748b; margin: 0;">Subjects for @Model.ClassName will be posted soon. Please check back later or select another class.</p>
        </div>
    }
    else
    {
        <div class="subject-picker-grid">
            @foreach (var s in Model.Subjects)
            {
                <label class="subject-card @(s.IsSelected ? "selected" : "")">
                    <input type="checkbox" name="selectedSubjectIds" value="@s.SubjectId" @(s.IsSelected ? "checked" : "") />
                    <div class="subject-card-top">
                        <div class="subject-icon">@s.IconText</div>
                        @if (!string.IsNullOrEmpty(s.Badge))
                        {
                            <span class="subject-badge @s.BadgeStyle">@s.Badge</span>
                        }
                    </div>
                    <h4>@s.Name</h4>
                    <p class="rating-line"><i class="bi bi-star-fill" style="color:#f59e0b;"></i> @s.Rating &nbsp;&middot;&nbsp; <i class="bi bi-person-fill me-1"></i> @s.TeacherName</p>
                    <p class="subject-desc">@s.Description</p>
                    <div class="subject-card-footer">
                        <div>
                            <div class="seats-label">Seats Left</div>
                            <div class="seats-num">@(s.SeatsLeft > 0 ? s.SeatsLeft.ToString() : "Available")</div>
                        </div>
                        <span class="select-pill">@(s.IsSelected ? "Selected" : "Select")</span>
                    </div>
                </label>
            }
        </div>
    }

    @section FooterActions {
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <span id="selectedCountBadge" style="font-size: 13px; font-weight: 700; color: #475569;">
                <span id="countNum">@Model.Subjects.Count(s => s.IsSelected)</span> subject(s) selected
            </span>
            <button type="submit" form="subjectForm" class="btn-next" style="background: #2563eb; color: #fff; padding: 12px 24px; border-radius: 12px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
                Continue to Intake <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    }
</form>

<script>
    function updateSelectedCount() {
        var checked = document.querySelectorAll('.subject-card input[type=checkbox]:checked').length;
        var countEl = document.getElementById('countNum');
        if (countEl) countEl.textContent = checked;
    }

    document.querySelectorAll('.subject-card input[type=checkbox]').forEach(function(cb) {
        cb.addEventListener('change', function() {
            var card = cb.closest('.subject-card');
            card.classList.toggle('selected', cb.checked);
            var pill = card.querySelector('.select-pill');
            if (pill) pill.textContent = cb.checked ? 'Selected' : 'Select';
            updateSelectedCount();
        });
    });

    updateSelectedCount();
</script>