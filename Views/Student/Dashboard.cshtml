@model TuitionCenter.Models.StudentDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="welcome-banner">
    <div class="welcome-left">
        <div class="welcome-avatar">@Model.AvatarInitial</div>
        <div>
            <h1>Good day, @Model.StudentName </h1>
            <div class="welcome-meta">
                <span class="badge-pill">@Model.ActiveCourseSummary</span>
                <span>@Model.Today.ToString("dddd, MMMM d, yyyy")</span>
            </div>
        </div>
    </div>
    <div class="next-session">
        Today
        <strong>
            @if (Model.TodaysSessionCount > 0)
            {
                @: You have @Model.TodaysSessionCount class today at @Model.TodaysSessionTimeRange
            }
            else
            {
                @: No class scheduled today
            }
        </strong>
    </div>
</div>

<div class="dash-stats">
    <div class="dash-stat-card">
        <div class="icon blue"><i class="bi bi-bookmark-fill"></i></div>
        <div>
            <p>Active Courses</p>
            <h2>@Model.ActiveEnrollmentCount</h2>
            <small class="link">@Model.ActiveCourseSummary</small>
        </div>
    </div>

    <div class="dash-stat-card">
        <div class="icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-calendar-event"></i></div>
        <div>
            <p>Today's Class</p>
            <h2>@Model.TodaysSessionCount</h2>
            <small class="ok">@Model.TodaysSessionTimeRange</small>
        </div>
    </div>

    <div class="dash-stat-card">
        <div class="icon" style="background:#fef9c3;color:#ca8a04;"><i class="bi bi-bar-chart-fill"></i></div>
        <div>
            <p>Sessions Completed</p>
            <h2>@Model.SessionsCompleted<span style="font-size:16px;color:#9ca3af;"> / @Model.SessionsTotal</span></h2>
            <small class="warn">@(Model.SessionsTotal == 0 ? "No sessions scheduled yet" : $"{(Model.SessionsCompleted * 100 / Math.Max(Model.SessionsTotal, 1))}% complete")</small>
        </div>
    </div>

    <div class="dash-stat-card">
        <div class="icon" style="background:#dcfce7;color:#16a34a;"><i class="bi bi-credit-card-fill"></i></div>
        <div>
            <p>Payment Status</p>
            <h2 style="font-size:20px;">
                @if (Model.PaymentStatus == "Approved" || Model.PaymentStatus == "Paid")
                {
                    <i class="bi bi-check-circle-fill" style="color:#16a34a;font-size:16px;"></i>
                }
                else
                {
                    <i class="bi bi-exclamation-circle-fill" style="color:#d97706;font-size:16px;"></i>
                }
                @Model.PaymentStatus - Rs @Model.PaymentAmount
            </h2>
        </div>
    </div>
</div>

<h3 class="section-title"><i class="bi bi-clock-history"></i> Upcoming Classes (@Model.UpcomingSessions.Count)</h3>

@if (!Model.UpcomingSessions.Any())
{
    <div class="card-panel" style="margin-bottom:30px;color:#6b7280;">
        No upcoming classes scheduled. Once you're enrolled and assigned to a batch, your sessions will show up here.
    </div>
}

@foreach (var s in Model.UpcomingSessions)
{
    <div class="class-card">
        <div class="class-card-main">
            <div class="class-badges">
                <span class="badge-subject">@s.SubjectName</span>
                <span class="badge-classnum">@s.ClassName</span>
                <span class="badge-status">@(s.IsToday ? "Today" : "Upcoming")</span>
            </div>
            <h3>@s.Title</h3>
            <div class="class-teacher">
                <div class="teacher-initial">@(s.TeacherName.Length > 0 ? s.TeacherName[0].ToString().ToUpper() : "?")</div>
                <div>
                    <p class="name">@s.TeacherName</p>
                </div>
            </div>
        </div>

        <div class="class-card-meta">
            <div><i class="bi bi-clock"></i> @s.TimeRange</div>
        </div>

        <div class="class-card-actions">
            <div class="start-in">Starts in @s.StartsInLabel</div>
            @if (!string.IsNullOrEmpty(s.MeetingLink))
            {
                <a href="@s.MeetingLink" target="_blank" class="btn btn-primary" style="text-align:center;">Join Class</a>
            }
        </div>
    </div>
}

<div class="dash-grid-2">
    <div class="card-panel">
        <h3 style="margin-top:0;">Announcements</h3>
        @if (!Model.Announcements.Any())
        {
            <p style="color:#6b7280;">No announcements yet.</p>
        }
        @foreach (var a in Model.Announcements)
        {
            <div class="announcement-item">
                <div class="icon" style="background:#dbeafe;color:#4f46e5;"><i class="bi bi-megaphone-fill"></i></div>
                <div>
                    <h4>@a.Title</h4>
                    <p>@a.Description</p>
                    <span>@a.TimeAgo · @a.TeacherName</span>
                </div>
            </div>
        }
    </div>

    <div class="card-panel">
        <h3 style="margin-top:0;">Course Management</h3>
        @if (!Model.EnrolledCourses.Any())
        {
            <p style="color:#6b7280;">You're not enrolled in any course yet.</p>
        }
        @foreach (var course in Model.EnrolledCourses)
        {
            <div class="course-mgmt-header">
                <h3>@course.ClassName - @course.SubjectsSummary</h3>
                <span class="price">Rs @course.Amount</span>
            </div>
            <p>@course.PlanLabel</p>
            <div class="course-progress-label">
                <span>Course Progress</span>
                <span>@course.SessionsCompleted/@course.SessionsTotal Classes</span>
            </div>
            <div class="mini-progress" style="width:100%;margin-bottom:20px;">
                <span style="width:@course.ProgressPercent%;"></span>
            </div>
        }
    </div>
</div>

<div class="dash-footer">
    <a asp-controller="Student" asp-action="EnrollClass" class="btn-enroll">+ Enroll New Course</a>
</div>