@model TuitionCenter.Models.StudentDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome Hero Card -->
<div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden mb-6 relative">
    <div class="absolute inset-0 bg-gradient-to-br from-indigo-600/5 via-violet-500/5 to-transparent pointer-events-none"></div>
    <div class="absolute top-0 left-0 bottom-0 w-1.5 bg-gradient-to-b from-indigo-500 to-violet-500 rounded-l-2xl"></div>
    <div class="px-8 py-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600
                flex items-center justify-center text-white font-extrabold text-2xl shadow-lg shadow-indigo-500/30">
                @Model.AvatarInitial
            </div>
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                    Good day, @Model.StudentName
                    <span class="inline-block animate-bounce ml-1">👋</span>
                </h1>
                <div class="flex items-center gap-3 mt-1.5 flex-wrap">
                    <span class="inline-flex items-center gap-1.5 bg-indigo-100 text-indigo-700 text-xs font-semibold px-3 py-1 rounded-full">
                        <i class="fas fa-book-open text-[10px]"></i>
                        @Model.ActiveCourseSummary
                    </span>
                    <span class="text-sm text-slate-400 font-medium">
                        <i class="fas fa-calendar-day mr-1 text-indigo-400"></i>
                        @Model.Today.ToString("dddd, MMMM d, yyyy")
                    </span>
                </div>
            </div>
        </div>
        <div class="flex-shrink-0 bg-indigo-50 border border-indigo-100 rounded-xl px-5 py-3 text-right">
            <p class="text-xs font-bold text-indigo-400 uppercase tracking-wider mb-0.5">Today's Schedule</p>
            @if (Model.TodaysSessionCount > 0)
            {
                <p class="text-sm font-bold text-indigo-700">
                    <i class="fas fa-clock mr-1"></i>
                    @Model.TodaysSessionCount class at @Model.TodaysSessionTimeRange
                </p>
            }
            else
            {
                <p class="text-sm font-semibold text-slate-500">No class scheduled today</p>
            }
        </div>
    </div>
</div>

<!-- KPI Stat Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 mb-6">

    <!-- Active Courses -->
    <div class="bg-white rounded-2xl border border-slate-100 p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 rounded-xl bg-indigo-100 flex items-center justify-center">
                <i class="fas fa-bookmark text-indigo-600 text-lg"></i>
            </div>
            <span class="text-xs font-bold bg-indigo-50 text-indigo-600 px-2.5 py-1 rounded-full">Active</span>
        </div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Active Courses</p>
        <h3 class="text-3xl font-extrabold text-slate-900 tracking-tight">@Model.ActiveEnrollmentCount</h3>
        <p class="text-xs text-slate-400 mt-1.5 truncate">@Model.ActiveCourseSummary</p>
    </div>

    <!-- Today's Class -->
    <div class="bg-white rounded-2xl border border-slate-100 p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 rounded-xl bg-emerald-100 flex items-center justify-center">
                <i class="fas fa-calendar-check text-emerald-600 text-lg"></i>
            </div>
            <span class="text-xs font-bold bg-emerald-50 text-emerald-600 px-2.5 py-1 rounded-full">Today</span>
        </div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Today's Classes</p>
        <h3 class="text-3xl font-extrabold text-slate-900 tracking-tight">@Model.TodaysSessionCount</h3>
        <p class="text-xs text-slate-400 mt-1.5">@Model.TodaysSessionTimeRange</p>
    </div>

    <!-- Sessions Progress -->
    <div class="bg-white rounded-2xl border border-slate-100 p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 rounded-xl bg-amber-100 flex items-center justify-center">
                <i class="fas fa-chart-bar text-amber-600 text-lg"></i>
            </div>
            <span class="text-xs font-bold bg-amber-50 text-amber-600 px-2.5 py-1 rounded-full">
                @(Model.SessionsTotal == 0 ? "0%" : $"{(Model.SessionsCompleted * 100 / Math.Max(Model.SessionsTotal, 1))}%")
            </span>
        </div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Sessions Done</p>
        <h3 class="text-3xl font-extrabold text-slate-900 tracking-tight">
            @Model.SessionsCompleted
            <span class="text-base font-semibold text-slate-400">/@Model.SessionsTotal</span>
        </h3>
        <div class="mt-2 h-1.5 bg-slate-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-amber-400 to-amber-500 rounded-full transition-all"
                 style="width:@(Model.SessionsTotal == 0 ? 0 : (Model.SessionsCompleted * 100 / Math.Max(Model.SessionsTotal, 1)))%"></div>
        </div>
    </div>

    <!-- Payment Status -->
    <div class="bg-white rounded-2xl border border-slate-100 p-5 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200">
        <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 rounded-xl @(Model.PaymentStatus == "Approved" || Model.PaymentStatus == "Paid" ? "bg-emerald-100" : "bg-orange-100") flex items-center justify-center">
                <i class="fas fa-credit-card @(Model.PaymentStatus == "Approved" || Model.PaymentStatus == "Paid" ? "text-emerald-600" : "text-orange-500") text-lg"></i>
            </div>
            <span class="text-xs font-bold px-2.5 py-1 rounded-full
                @(Model.PaymentStatus == "Approved" || Model.PaymentStatus == "Paid"
                    ? "bg-emerald-50 text-emerald-600"
                    : "bg-orange-50 text-orange-600")">
                @Model.PaymentStatus
            </span>
        </div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Payment</p>
        <h3 class="text-2xl font-extrabold text-slate-900 tracking-tight">Rs @Model.PaymentAmount</h3>
        <p class="text-xs text-slate-400 mt-1.5">Latest enrollment fee</p>
    </div>
</div>

<!-- Upcoming Sessions -->
<div class="mb-6">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-extrabold text-slate-800 flex items-center gap-2">
            <i class="fas fa-clock text-indigo-400"></i>
            Upcoming Classes
            <span class="ml-1 text-sm font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full">@Model.UpcomingSessions.Count</span>
        </h2>
        <a href="@Url.Action("EnrollClass", "Student")" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition-colors">
            View all <i class="fas fa-arrow-right ml-1"></i>
        </a>
    </div>

    @if (!Model.UpcomingSessions.Any())
    {
        <div class="bg-white rounded-2xl border border-slate-100 p-8 text-center shadow-sm">
            <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-3">
                <i class="fas fa-calendar-times text-slate-400 text-2xl"></i>
            </div>
            <p class="text-slate-500 font-medium">No upcoming classes scheduled.</p>
            <p class="text-slate-400 text-sm mt-1">Enroll in a course to see your sessions here.</p>
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var s in Model.UpcomingSessions)
            {
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5
                    hover:border-indigo-200 hover:shadow-md transition-all duration-200
                    flex flex-col md:flex-row md:items-center gap-4">
                    <!-- Left accent + info -->
                    <div class="flex items-start gap-4 flex-1 min-w-0">
                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600
                            flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                            @(s.TeacherName.Length > 0 ? s.TeacherName[0].ToString().ToUpper() : "?")
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2 mb-1">
                                <span class="text-xs font-bold bg-indigo-100 text-indigo-700 px-2.5 py-0.5 rounded-full">@s.SubjectName</span>
                                <span class="text-xs font-bold bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full">@s.ClassName</span>
                                @if (s.IsToday)
                                {
                                    <span class="text-xs font-extrabold bg-emerald-100 text-emerald-700 px-2.5 py-0.5 rounded-full flex items-center gap-1">
                                        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                                        Today
                                    </span>
                                }
                            </div>
                            <p class="text-sm font-bold text-slate-800 truncate">@s.Title</p>
                            <p class="text-xs text-slate-400 mt-0.5">
                                <i class="fas fa-user-tie mr-1"></i>@s.TeacherName
                                <span class="mx-1.5 text-slate-300">·</span>
                                <i class="fas fa-clock mr-1"></i>@s.TimeRange
                            </p>
                        </div>
                    </div>
                    <!-- Right: starts-in + join -->
                    <div class="flex items-center gap-3 flex-shrink-0">
                        <span class="text-xs font-semibold text-slate-500 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200">
                            <i class="fas fa-hourglass-half mr-1 text-slate-400"></i>
                            @s.StartsInLabel
                        </span>
                        @if (!string.IsNullOrEmpty(s.MeetingLink))
                        {
                            <a href="@s.MeetingLink" target="_blank"
                               class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white
                                text-xs font-bold px-4 py-2 rounded-xl shadow-sm shadow-indigo-500/20
                                transition-all duration-150 hover:scale-105">
                                <i class="fas fa-video"></i> Join Class
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Bottom Grid: Announcements + My Courses -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-6">

    <!-- Announcements -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <h3 class="text-base font-extrabold text-slate-800 mb-4 flex items-center gap-2">
            <i class="fas fa-bullhorn text-indigo-400"></i>
            Announcements
        </h3>
        @if (!Model.Announcements.Any())
        {
            <div class="text-center py-6">
                <i class="fas fa-bell-slash text-slate-300 text-3xl mb-2"></i>
                <p class="text-slate-400 text-sm">No announcements yet.</p>
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var a in Model.Announcements)
                {
                    <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-xl hover:bg-indigo-50 transition-colors">
                        <div class="w-9 h-9 rounded-xl bg-indigo-100 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-megaphone text-indigo-600 text-sm"></i>
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-slate-800">@a.Title</p>
                            <p class="text-xs text-slate-500 mt-0.5 line-clamp-2">@a.Description</p>
                            <p class="text-[11px] text-slate-400 mt-1 font-medium">
                                @a.TimeAgo · @a.TeacherName
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- My Courses Progress -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
        <h3 class="text-base font-extrabold text-slate-800 mb-4 flex items-center gap-2">
            <i class="fas fa-chart-line text-violet-400"></i>
            My Course Progress
        </h3>
        @if (!Model.EnrolledCourses.Any())
        {
            <div class="text-center py-6">
                <i class="fas fa-book text-slate-300 text-3xl mb-2"></i>
                <p class="text-slate-400 text-sm">You're not enrolled in any course yet.</p>
                <a href="@Url.Action("Subject", "Student")"
                   class="inline-block mt-3 text-xs font-bold text-indigo-600 hover:text-indigo-800">
                    Enroll now <i class="fas fa-arrow-right ml-1"></i>
                </a>
            </div>
        }
        else
        {
            <div class="space-y-4">
                @foreach (var course in Model.EnrolledCourses)
                {
                    <div class="p-4 bg-slate-50 rounded-xl">
                        <div class="flex items-center justify-between mb-1">
                            <p class="text-sm font-bold text-slate-800 truncate">
                                @course.ClassName
                                <span class="text-slate-400 font-medium text-xs ml-1">— @course.SubjectsSummary</span>
                            </p>
                            <span class="text-xs font-semibold text-indigo-600 flex-shrink-0 ml-2">Rs @course.Amount</span>
                        </div>
                        <p class="text-xs text-slate-500 mb-2">@course.PlanLabel</p>
                        <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
                            <span>Progress</span>
                            <span class="font-semibold text-slate-600">@course.SessionsCompleted / @course.SessionsTotal sessions</span>
                        </div>
                        <div class="h-1.5 bg-slate-200 rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-indigo-500 to-violet-500 rounded-full transition-all"
                                 style="width:@course.ProgressPercent%"></div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- CTA Footer -->
<div class="flex justify-end">
    <a href="@Url.Action("Subject", "Student")"
       class="inline-flex items-center gap-2 bg-gradient-to-r from-indigo-600 to-violet-600
        hover:from-indigo-700 hover:to-violet-700 text-white font-bold
        px-6 py-3 rounded-xl shadow-md shadow-indigo-500/25
        transition-all duration-200 hover:scale-105 hover:shadow-lg hover:shadow-indigo-500/30">
        <i class="fas fa-plus"></i>
        Enroll New Course
    </a>
</div>
