@model TuitionCenter.Models.IntakeViewModel
@{
    ViewData["Title"] = "Select Course Type";
}

<div class="intake-container">
    <h2>Select Course Plan</h2>
    <form id="intakeForm" method="post">
        <input type="hidden" asp-for="ClassId" />
        
        <div class="course-types-group">
            @if (Model?.CourseTypes != null)
            {
                foreach (var ct in Model.CourseTypes)
                {
                    <div class="course-type-card">
                        <input type="radio" asp-for="SelectedCourseTypeId" value="@ct.CourseTypeId" id="ct_@ct.CourseTypeId" class="course-type-radio" onchange="filterBatchesByCourseType()" />
                        <label for="ct_@ct.CourseTypeId">
                            <h4>@ct.TypeName</h4>
                        </label>
                    </div>
                }
            }
        </div>
    </form>
</div>

@section FooterActions {
    <button type="submit" form="intakeForm" class="btn-next">Next <i class="bi bi-arrow-right"></i></button>
}

<script>
    function filterBatchesByCourseType() {
        var selected = document.querySelector('.course-type-radio:checked');
        if (!selected) return;
        var courseTypeId = selected.value;

        document.querySelectorAll('.batch-option').forEach(function(opt) {
            var match = opt.dataset.coursetype === courseTypeId;
            opt.style.display = match ? 'flex' : 'none';
            if (!match) {
                var radio = opt.querySelector('input[type="radio"]');
                if (radio) radio.checked = false;
            }
        });
    }
</script>
