@model List<TuitionCenter.Models.ClassPickerItem>

@{
    ViewData["Title"] = "Select Class";
    Layout = "_EnrollmentLayout";
    ViewData["ActiveStep"] = "Subject";
}

@if (TempData["EnrollError"] != null)
{
    <div class="enroll-alert">@TempData["EnrollError"]</div>
}

<h3 class="intake-section-title" style="margin-top:0;">Select a class to choose subjects</h3>

<div class="class-picker-grid">
    @foreach (var c in Model)
    {
        <a class="class-tile @(c.IsEnrolled ? "my-enrolled" : "")" asp-action="Subject" asp-route-classId="@c.ClassId">
            <div class="class-tile-top">
                <div class="class-tile-num @(c.Label.Length > 2 ? "wide" : "")">@c.Label</div>
                <span class="class-tile-count"><i class="bi bi-people-fill"></i> @c.EnrolledStudentCount enrolled</span>
            </div>
            <h4>@c.ClassName</h4>
            <p class="class-tile-subtitle">@c.Subtitle</p>
            @if (c.IsEnrolled)
            {
                <p class="class-tile-mystatus">You: @c.EnrollmentStatusLabel</p>
            }
        </a>
    }
</div>