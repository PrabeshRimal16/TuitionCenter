@{
    ViewData["Title"] = "TuitionCenter — Learn Without Limits";
    ViewData["BodyClass"] = "landing-page";
}

<!-- ======================================================
     HERO SECTION
     ====================================================== -->
<section class="hero-section" id="home">
    <!-- Background blobs -->
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero-blob hero-blob-3"></div>
    <!-- Floating shapes -->
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
    <div class="hero-shape hero-shape-4"></div>

    <div style="position:relative;z-index:1;max-width:780px;margin:0 auto;">
        <div class="hero-badge">
            <span class="badge-dot"></span>
            Nepal's Trusted Tuition Platform
        </div>

        <h1 class="hero-title">
            Unlock Your Full<br />
            <span class="gradient-text">Academic Potential</span>
        </h1>

        <p class="hero-subtitle">
            Connect with expert tutors, join structured courses, and track your
            progress — all in one beautifully designed learning hub.
        </p>

        <div class="hero-actions">
            <a asp-controller="Account" asp-action="Register" class="btn-hero-primary" id="heroGetStartedBtn">
                🚀 Get Started Free
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn-hero-secondary" id="heroLoginBtn">
                Sign In
            </a>
        </div>
    </div>

    <div class="scroll-indicator" aria-hidden="true">
        <span>Scroll</span>
        <div class="scroll-arrow"></div>
    </div>
</section>

<!-- ======================================================
     STATS SECTION
     ====================================================== -->
<section class="stats-section" id="stats">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item reveal">
                <div class="stat-number" data-target="1200">0</div>
                <div class="stat-label">Active Students</div>
            </div>
            <div class="stat-item reveal reveal-delay-1">
                <div class="stat-number" data-target="85">0</div>
                <div class="stat-label">Expert Teachers</div>
            </div>
            <div class="stat-item reveal reveal-delay-2">
                <div class="stat-number" data-target="240">0</div>
                <div class="stat-label">Courses Available</div>
            </div>
            <div class="stat-item reveal reveal-delay-3">
                <div class="stat-number" data-target="98">0</div>
                <div class="stat-label">% Satisfaction Rate</div>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================
     FEATURES SECTION
     ====================================================== -->
<section class="landing-section features-section" id="features">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="section-eyebrow">Why Choose Us</span>
            <h2 class="section-title">Everything You Need to <span class="gradient-text">Excel</span></h2>
            <p class="section-subtitle mx-auto">
                Our platform is built with students in mind — giving you the tools, teachers,
                and structure to achieve outstanding results.
            </p>
        </div>

        <div class="features-grid">
            <div class="feature-card reveal">
                <div class="feature-icon-wrap purple">🎓</div>
                <h3 class="feature-title">Expert Teachers</h3>
                <p class="feature-desc">Learn from qualified, experienced educators who are passionate about helping you succeed in every subject.</p>
            </div>
            <div class="feature-card reveal reveal-delay-1">
                <div class="feature-icon-wrap cyan">📅</div>
                <h3 class="feature-title">Flexible Schedules</h3>
                <p class="feature-desc">Book sessions that fit your timetable. Study at your own pace with on-demand materials and live classes.</p>
            </div>
            <div class="feature-card reveal reveal-delay-2">
                <div class="feature-icon-wrap amber">📊</div>
                <h3 class="feature-title">Track Progress</h3>
                <p class="feature-desc">Monitor your learning journey with detailed dashboards, attendance records, and performance insights.</p>
            </div>
            <div class="feature-card reveal reveal-delay-3">
                <div class="feature-icon-wrap green">✅</div>
                <h3 class="feature-title">Structured Courses</h3>
                <p class="feature-desc">Access well-organized course materials, assignments, and assessments designed for maximum retention.</p>
            </div>
            <div class="feature-card reveal reveal-delay-4">
                <div class="feature-icon-wrap pink">💬</div>
                <h3 class="feature-title">Direct Communication</h3>
                <p class="feature-desc">Stay connected with your teachers and get timely feedback to clear doubts and accelerate learning.</p>
            </div>
            <div class="feature-card reveal reveal-delay-5">
                <div class="feature-icon-wrap rose">🏆</div>
                <h3 class="feature-title">Certified Results</h3>
                <p class="feature-desc">Earn recognition for your hard work with certificates upon completing your enrolled courses.</p>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================
     HOW IT WORKS SECTION
     ====================================================== -->
<section class="landing-section how-section" id="how">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="section-eyebrow">Simple Process</span>
            <h2 class="section-title">Get Started in <span class="gradient-text">3 Easy Steps</span></h2>
            <p class="section-subtitle mx-auto">
                From registration to your first lesson — it takes just minutes to begin your learning journey.
            </p>
        </div>

        <div class="steps-grid">
            <div class="step-item reveal">
                <div class="step-number">1</div>
                <h4 class="step-title">Create Your Account</h4>
                <p class="step-desc">Sign up as a student or teacher in seconds. No credit card required to get started.</p>
            </div>
            <div class="step-item reveal reveal-delay-2">
                <div class="step-number">2</div>
                <h4 class="step-title">Browse & Enroll</h4>
                <p class="step-desc">Explore our curated list of courses and enroll in the subjects that match your academic goals.</p>
            </div>
            <div class="step-item reveal reveal-delay-4">
                <div class="step-number">3</div>
                <h4 class="step-title">Learn & Grow</h4>
                <p class="step-desc">Attend sessions, complete assignments, get feedback, and watch your performance improve.</p>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================
     CTA SECTION
     ====================================================== -->
<section class="cta-section" id="cta">
    <div class="container">
        <div class="cta-card reveal">
            <h2>Ready to <span class="gradient-text">Transform</span> Your Learning?</h2>
            <p>Join over 1,200 students already learning on TuitionCenter. Your academic success story starts here.</p>
            <div class="cta-actions">
                <a asp-controller="Account" asp-action="Register" class="btn-hero-primary" id="ctaRegisterBtn">
                    🎓 Start Learning Today
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn-hero-secondary" id="ctaLoginBtn">
                    Already a member? Sign In
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ======================================================
     FOOTER
     ====================================================== -->
<footer class="landing-footer">
    <div class="container">
        <div class="footer-brand">TuitionCenter</div>
        <p style="margin:0;color:#475569;font-size:0.85rem;">
            &copy; @DateTime.Now.Year TuitionCenter. Empowering learners across Nepal.
        </p>
    </div>
</footer>

@section Scripts {
<script>
    // ── Sticky navbar on scroll ──
    const navbar = document.getElementById('siteNavbar');
    window.addEventListener('scroll', () => {
        if (window.scrollY > 30) {
            navbar?.classList.add('scrolled');
        } else {
            navbar?.classList.remove('scrolled');
        }
    });

    // ── Reveal on scroll (Intersection Observer) ──
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.12 });
    reveals.forEach(el => observer.observe(el));

    // ── Animated counters ──
    function animateCounter(el) {
        const target = parseInt(el.dataset.target, 10);
        const suffix = el.dataset.target.includes('%') ? '%' : '+';
        let current = 0;
        const increment = Math.ceil(target / 60);
        const timer = setInterval(() => {
            current = Math.min(current + increment, target);
            el.textContent = current.toLocaleString() + suffix;
            if (current >= target) clearInterval(timer);
        }, 25);
    }
    const statsObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                animateCounter(entry.target);
                statsObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.5 });
    document.querySelectorAll('.stat-number').forEach(el => statsObserver.observe(el));
</script>
}
